<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="CleanDay" TargetType="CalendarDayButton">
  <Setter Property="Height" Value="48"/><Setter Property="MinWidth" Value="24"/><Setter Property="Margin" Value="3"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#293D35"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CalendarDayButton">
   <Border x:Name="Day" CornerRadius="12" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"><Grid><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"><Ellipse x:Name="EventDot" Width="5" Height="5" Fill="#3176B5" Margin="2,0" Visibility="Collapsed"/><Rectangle x:Name="SpecialDot" Width="5" Height="5" Fill="#CA7B19" Margin="2,0" Visibility="Collapsed"/></StackPanel></Grid></Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Day" Property="Background" Value="#F0F6F1"/></Trigger>
    <Trigger Property="IsToday" Value="True"><Setter TargetName="Day" Property="BorderBrush" Value="#75A986"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#256641"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Day" Property="Background" Value="#E0EDE3"/><Setter TargetName="Day" Property="BorderBrush" Value="#286A47"/><Setter Property="Foreground" Value="#263E2F"/><Setter Property="FontWeight" Value="Bold"/></Trigger>
    <DataTrigger Binding="{Binding DayOfWeek}" Value="Saturday"><Setter Property="Foreground" Value="#2474B6"/></DataTrigger>
    <DataTrigger Binding="{Binding DayOfWeek}" Value="Sunday"><Setter Property="Foreground" Value="#C44343"/></DataTrigger>
    <DataTrigger Binding="{Binding Tag.IsHoliday,RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Foreground" Value="#C44343"/></DataTrigger>
    <DataTrigger Binding="{Binding Tag.HasEvent,RelativeSource={RelativeSource Self}}" Value="True"><Setter TargetName="EventDot" Property="Visibility" Value="Visible"/></DataTrigger>
    <DataTrigger Binding="{Binding Tag.HasSpecial,RelativeSource={RelativeSource Self}}" Value="True"><Setter TargetName="SpecialDot" Property="Visibility" Value="Visible"/></DataTrigger>
    <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="#BDCBC3"/></Trigger>
    <Trigger Property="IsBlackedOut" Value="True"><Setter Property="Opacity" Value="0.35"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Day" Property="BorderBrush" Value="#152F23"/><Setter TargetName="Day" Property="BorderThickness" Value="2"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="CleanCalendarButton" TargetType="CalendarButton">
  <Setter Property="Margin" Value="4"/><Setter Property="Height" Value="58"/><Setter Property="Foreground" Value="#293D35"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CalendarButton"><Border x:Name="Bd" CornerRadius="10" Background="#F5F8F5"><Grid><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"><Ellipse x:Name="EventDot" Width="5" Height="5" Fill="#3176B5" Margin="2,0" Visibility="Collapsed"/><Rectangle x:Name="SpecialDot" Width="5" Height="5" Fill="#CA7B19" Margin="2,0" Visibility="Collapsed"/></StackPanel></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#DDECE0"/></Trigger><Trigger Property="IsInactive" Value="True"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="CleanCalendar" TargetType="Calendar">
  <Setter Property="Language" Value="ko-KR"/><Setter Property="FirstDayOfWeek" Value="Monday"/><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/>
  <Setter Property="CalendarDayButtonStyle" Value="{StaticResource CleanDay}"/><Setter Property="CalendarButtonStyle" Value="{StaticResource CleanCalendarButton}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Calendar"><Border Background="{TemplateBinding Background}" Padding="2"><CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}" Background="{TemplateBinding Background}" BorderThickness="0"/></Border></ControlTemplate></Setter.Value></Setter>
  <Setter Property="CalendarItemStyle"><Setter.Value><Style TargetType="CalendarItem">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CalendarItem">
    <Grid x:Name="PART_Root">
     <Grid.Resources><DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}"><TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#7C8E83" Margin="0,12"/></DataTemplate></Grid.Resources>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="2,0,2,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
      <Button x:Name="PART_HeaderButton" HorizontalAlignment="Left" FontSize="21" FontWeight="Bold" Background="Transparent" BorderThickness="0" Foreground="#233E2F" Padding="8,0"/>
      <Button x:Name="PART_PreviousButton" Grid.Column="1" Content="‹" FontSize="24" Padding="0" Margin="2" ToolTip="이전 달"/>
      <Button x:Name="PART_NextButton" Grid.Column="2" Content="›" FontSize="24" Padding="0" Margin="2" ToolTip="다음 달"/>
     </Grid>
     <UniformGrid x:Name="WeekdayLabels" Grid.Row="1" Columns="7" Margin="0,2,0,10"><UniformGrid.Resources><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#7C8E83"/></Style></UniformGrid.Resources><TextBlock Text="월"/><TextBlock Text="화"/><TextBlock Text="수"/><TextBlock Text="목"/><TextBlock Text="금"/><TextBlock Text="토" Foreground="#6C89A6"/><TextBlock Text="일" Foreground="#B57B70"/></UniformGrid>
     <Grid x:Name="PART_MonthView" Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="0"/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     </Grid>
     <Grid x:Name="PART_YearView" Grid.Row="1" Grid.RowSpan="2" Visibility="Hidden">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     </Grid>
    </Grid>
    <ControlTemplate.Triggers>
     <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Year"><Setter TargetName="WeekdayLabels" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/></DataTrigger>
     <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Decade"><Setter TargetName="WeekdayLabels" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/></DataTrigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
