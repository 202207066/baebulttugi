<Window x:Class="wpf.Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="스마트 급식 및 알러지 케어 솔루션" Height="850" Width="1450"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA"
        FontFamily="Segoe UI, Malgun Gothic">

    <Window.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="15,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EDF2F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid Margin="20,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                    <Ellipse Width="35" Height="35" Fill="#3182CE" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="MealCare AI" FontSize="20" FontWeight="Bold" Foreground="#1A202C"/>
                        <TextBlock Text="v2.0 Enterprise" FontSize="11" Foreground="#A0AEC0" Margin="1,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" VerticalAlignment="Top">

                    <Button x:Name="BtnDashboard" Style="{StaticResource SidebarButtonStyle}" Click="BtnDashboard_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏠" FontSize="18" Margin="0,0,15,0"/>
                            <TextBlock Text="종합 대시보드" FontSize="15" Foreground="#4A5568"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnMenuTable" Style="{StaticResource SidebarButtonStyle}" Click="BtnMenuTable_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="18" Margin="0,0,15,0"/>
                            <TextBlock Text="식단 자동 조합" FontSize="15" Foreground="#4A5568"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnMenuManage" Style="{StaticResource SidebarButtonStyle}" Click="BtnMenuManage_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🍳" FontSize="18" Margin="0,0,15,0"/>
                            <TextBlock Text="메뉴(레시피) 관리" FontSize="15" Foreground="#4A5568"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnIngredientsDb" Style="{StaticResource SidebarButtonStyle}" Click="BtnIngredientsDb_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌿" FontSize="18" Margin="0,0,15,0"/>
                            <TextBlock Text="식재료 원천 DB" FontSize="15" Foreground="#4A5568"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnManagement" Style="{StaticResource SidebarButtonStyle}" Click="BtnManagement_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" FontSize="18" Margin="0,0,15,0"/>
                            <TextBlock Text="피급식자 알러지 관리" FontSize="15" Foreground="#4A5568"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnCalculate" Style="{StaticResource SidebarButtonStyle}" Click="BtnCalculate_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💵" FontSize="18" Margin="0,0,15,0"/>
                            <TextBlock Text="원가 / 소요량 계산" FontSize="15" Foreground="#4A5568"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnCalendar" Style="{StaticResource SidebarButtonStyle}" Click="BtnCalendar_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅" FontSize="18" Margin="0,0,15,0"/>
                            <TextBlock Text="이벤트 및 절기 달력" FontSize="15" Foreground="#4A5568"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <Border Grid.Row="3" Background="#F7FAFC" CornerRadius="12" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="40" Height="40" Fill="#CBD5E0" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="영양사 최고관리자" FontSize="14" FontWeight="SemiBold" Foreground="#2D3748"/>
                            <TextBlock Text="식단관리팀" FontSize="12" Foreground="#718096"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Navigated="MainFrame_Navigated"/>
        </Grid>
    </Grid>
</Window>