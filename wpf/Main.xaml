<Window x:Class="wpf.Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="배불뚝이 · 스마트 식단 및 알러지 케어" Height="880" Width="1480"
        MinHeight="600" MinWidth="960" WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Canvas}"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>

        <!-- 사이드바 메뉴 항목 -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="12,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="MainNav"/>
            <Setter Property="Foreground" Value="#C3DCC6"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="10"/>
                            <Border x:Name="Accent" Width="4" Height="24"
                                    HorizontalAlignment="Left" CornerRadius="0,3,3,0"
                                    Background="{StaticResource Lime}" Opacity="0"/>
                            <ContentPresenter Margin="20,0,12,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#25612A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#17421B"/>
                                <Setter TargetName="Accent" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 사이드바 그룹 제목 -->
        <Style x:Key="NavGroup" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#7FA884"/>
            <Setter Property="Margin" Value="28,10,0,4"/>
        </Style>

        <Style x:Key="FacilitySelector" TargetType="ComboBox">
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="SelectorToggle" Style="{x:Null}" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#F1F7F2" CornerRadius="8" BorderBrush="#AFCBB4" BorderThickness="1"/></ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <TextBlock x:Name="SelectedFacilityName" Margin="10,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}}" TextTrimming="CharacterEllipsis" Foreground="{TemplateBinding Foreground}"/>
                        <TextBlock x:Name="Placeholder" Text="설정해 주세요" Margin="10,0,28,0" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" Foreground="#65836B"/>
                        <TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                            <Border Background="White" CornerRadius="8" BorderBrush="#AFCBB4" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4">
                                <ScrollViewer MaxHeight="240"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers><Trigger Property="SelectedIndex" Value="-1"><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <!-- 도움말 카드 한 줄 -->
        <Style x:Key="HelpRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CanvasSoft}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="268"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ 사이드바 ═══════════ -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                    <GradientStop Color="{StaticResource BrandColor}" Offset="0"/>
                    <GradientStop Color="{StaticResource BrandDeepColor}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 로고 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,18,0,6">
                    <Canvas Width="42" Height="42" Margin="0,0,12,0">
                        <Path Data="M21,19 C21,13 21,10 21,6"
                              Stroke="{StaticResource LimeSoft}" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Ellipse Canvas.Left="22" Canvas.Top="4" Width="15" Height="8.5"
                                 Fill="{StaticResource LimeSoft}">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-25" CenterX="7.5" CenterY="4.25"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Path Fill="#EAF6EB" Data="M8,23 A13,7.5 0 0 1 34,23 Z"/>
                        <Path Fill="White" Data="M4,23 A17,17 0 0 0 38,23 Z"/>
                    </Canvas>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="배불뚝이" FontSize="21" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="SMART MEAL CARE" FontSize="9.5"
                                   Foreground="#9FC7A4" Margin="1,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 메뉴 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,0">
                    <StackPanel>

                        <TextBlock Text="오늘" Style="{StaticResource NavGroup}"/>

                        <RadioButton x:Name="BtnDashboard" Style="{StaticResource NavItem}"
                                     Click="BtnDashboard_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="17" Margin="0,0,14,0"/>
                                <TextBlock Text="종합 대시보드"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="식단 계획" Style="{StaticResource NavGroup}"/>

                        <RadioButton x:Name="BtnManagement" Style="{StaticResource NavItem}"
                                     Click="BtnManagement_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥" FontSize="17" Margin="0,0,14,0"/>
                                <TextBlock Text="피급식자 · 알러지"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="BtnMenuTable" Style="{StaticResource NavItem}"
                                     Click="BtnMenuTable_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🍽️" FontSize="17" Margin="0,0,14,0"/>
                                <TextBlock Text="식단 만들기"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="BtnCalculate" Style="{StaticResource NavItem}"
                                     Click="BtnCalculate_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💵" FontSize="17" Margin="0,0,14,0"/>
                                <TextBlock Text="원가 · 소요량 계산"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="BtnCalendar" Style="{StaticResource NavItem}"
                                     Click="BtnCalendar_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📅" FontSize="17" Margin="0,0,14,0"/>
                                <TextBlock Text="이벤트 · 절기 달력"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="기준 정보" Style="{StaticResource NavGroup}"/>

                        <RadioButton x:Name="BtnMenuManage" Style="{StaticResource NavItem}"
                                     Click="BtnMenuManage_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🍳" FontSize="17" Margin="0,0,14,0"/>
                                <TextBlock Text="메뉴(레시피) 관리"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="BtnIngredientsDb" Style="{StaticResource NavItem}"
                                     Click="BtnIngredientsDb_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌿" FontSize="17" Margin="0,0,14,0"/>
                                <TextBlock Text="메뉴·영양정보 자료"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="구글 시트 열기" Style="{StaticResource NavGroup}"/>
                        <Button Content="공공 메뉴 자료 보기" Click="OpenPublicData_Click" Margin="18,4" Padding="10,8" ToolTip="기준 메뉴·영양정보와 사용 설명을 브라우저에서 엽니다"/>
                        <Button Content="내 식단 자료 보기" Click="OpenMyData_Click" Margin="18,4" Padding="10,8" ToolTip="내 구글 드라이브에 저장된 자료를 엽니다"/>
                        <Border Margin="18,12,18,14" Padding="12" CornerRadius="12" Background="#17421B" BorderBrush="#527958" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="급식소 관리" Foreground="#C3DCC6" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                <ComboBox x:Name="FacilityBox" Style="{StaticResource FacilitySelector}" DisplayMemberPath="Name" SelectionChanged="FacilityChanged" Height="36" FontSize="14" Padding="10,4" Background="#F4F8F4" Foreground="#203E2B"/>
                                <TextBlock x:Name="FacilityCount" Foreground="#DCECDC" FontSize="12" Margin="0,8,0,10"/>
                                <UniformGrid Columns="3">
                                    <Button Content="추가" Click="FacilityAdd_Click" Background="#F1F7F2" Foreground="#244B2D" BorderBrush="#AFCBB4" FontSize="12" Padding="0,6" Margin="0,0,4,0" MinWidth="0"/>
                                    <Button x:Name="FacilityEditButton" Content="수정" Click="FacilityEdit_Click" Background="#F1F7F2" Foreground="#244B2D" BorderBrush="#AFCBB4" FontSize="12" Padding="0,6" Margin="0,0,4,0" MinWidth="0"/>
                                    <Button x:Name="FacilityDeleteButton" Style="{StaticResource DangerButton}" Content="삭제" Click="FacilityDelete_Click" FontSize="12" Padding="0,6" MinWidth="0"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#14391A" Padding="16,12" Margin="14,6,14,14" CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                            <Ellipse Width="38" Height="38" Fill="{StaticResource Lime}"/>
                            <TextBlock x:Name="SideAccountInitial" Text="?" FontSize="16" FontWeight="Bold" Foreground="#17421B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="SideAccountName" Text="로그인됨" FontSize="13.5" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="SideAccountEmail" FontSize="11" Foreground="#9FC7A4" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- ═══════════ 본문 ═══════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 상단 바 -->
            <Border Grid.Row="0" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPageTitle" TextTrimming="CharacterEllipsis" Text="종합 대시보드"
                                   FontSize="19" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                        <TextBlock x:Name="TxtPageSubtitle" TextTrimming="CharacterEllipsis" Text="오늘의 식단과 알러지 현황을 한눈에 봅니다"
                                   FontSize="12" Foreground="{StaticResource InkSubtle}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <TextBlock x:Name="TxtToday" Text="" FontSize="12.5"
                                   Foreground="{StaticResource InkSubtle}"
                                   VerticalAlignment="Center" Margin="0,0,20,0"/>

                        <Border Background="#EAF3EB" CornerRadius="18" Padding="14,6" Margin="0,0,14,0">
                            <StackPanel MaxWidth="170">
                                <TextBlock x:Name="AccountName" Text="로그인됨" Foreground="#244B2D" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="AccountEmail" FontSize="10" Foreground="#65836B" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="BtnHelp" Style="{StaticResource GhostButton}" Content="? 도움말" MinWidth="96"
                                Click="BtnHelp_Click" Margin="0,0,16,0"
                                ToolTip="처음 사용 안내와 화면 설명을 다시 봅니다"/>

                        <Button x:Name="BtnLogout" Style="{StaticResource GhostButton}" Content="로그아웃" MinWidth="108" Height="Auto" Padding="12,8"
                                FontSize="13" FontWeight="SemiBold" Click="BtnLogout_Click" Margin="0,0,16,0"
                                ToolTip="이 PC에 저장된 구글 로그인 정보를 지웁니다"/>


                    </StackPanel>
                </Grid>
            </Border>

            <!-- 페이지 영역 -->
            <!-- 로딩 안내는 콘텐츠 행을 차지하지 않는 오버레이다. 페이지 크기가 바뀌지 않는다. -->
            <Border Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="10" x:Name="ActivityBanner" Visibility="Collapsed" Background="#E8F3E9" Padding="24,8" VerticalAlignment="Top" Margin="0,76,0,0">
                <StackPanel><TextBlock x:Name="ActivityText" FontSize="13" Margin="0,0,0,5" TextWrapping="Wrap"/><ProgressBar IsIndeterminate="True" Height="4"/></StackPanel>
            </Border>
            <Frame Grid.Row="2" x:Name="MainFrame" NavigationUIVisibility="Hidden"
                   Navigated="MainFrame_Navigated"/>

            <!-- ── 도움말 오버레이 ───────────────────────────────── -->
            <Grid x:Name="HelpOverlay" Grid.Row="0" Grid.RowSpan="3"
                  Background="#99000000" Visibility="Collapsed"
                  MouseLeftButtonDown="HelpOverlay_MouseLeftButtonDown">

                <Border Width="640" MaxHeight="660" VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="{StaticResource Surface}" CornerRadius="16"
                        Padding="30" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,18">
                            <TextBlock Text="화면 안내" Style="{StaticResource PageTitle}"/>
                            <TextBlock Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{StaticResource InkMuted}"
                                       Text="왼쪽 메뉴는 실제 업무 순서대로 놓여 있습니다. 위에서 아래로 따라가시면 됩니다."/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource HelpRow}">
                                    <StackPanel>
                                        <TextBlock Text="① 피급식자 · 알러지" FontWeight="Bold" FontSize="14"
                                                   Foreground="{StaticResource Brand}"/>
                                        <TextBlock Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{StaticResource InkMuted}"
                                                   Text="가장 먼저 할 일입니다. 여기 등록된 알러지 성분이 식단 만들기에서 제외 기준이 됩니다. 등록이 비어 있으면 알러지 필터가 동작하지 않습니다."/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource HelpRow}">
                                    <StackPanel>
                                        <TextBlock Text="② 식단 만들기" FontWeight="Bold" FontSize="14"
                                                   Foreground="{StaticResource Brand}"/>
                                        <TextBlock Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{StaticResource InkMuted}"
                                                   Text="나이대, 식사 날짜와 끼니, 한 끼 목표 영양소를 선택하면 일주일 식단을 만들고 내 구글 시트에 저장합니다. 꼭 포함할 메뉴도 선택할 수 있습니다."/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource HelpRow}">
                                    <StackPanel>
                                        <TextBlock Text="③ 원가 · 소요량 계산" FontWeight="Bold" FontSize="14"
                                                   Foreground="{StaticResource Brand}"/>
                                        <TextBlock Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{StaticResource InkMuted}"
                                                   Text="인원수와 목표 급식비를 넣으면 식재료별 소요량과 원가를 계산하고, 예산을 넘으면 알려 줍니다. 결과는 CSV로 내보낼 수 있습니다."/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource HelpRow}">
                                    <StackPanel>
                                        <TextBlock Text="기준 정보 (메뉴 · 식재료)" FontWeight="Bold" FontSize="14"
                                                   Foreground="{StaticResource InkMuted}"/>
                                        <TextBlock Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{StaticResource InkMuted}"
                                                   Text="공공 메뉴 자료의 트랙A는 3~5세, 트랙B는 6~18세용입니다. 메뉴별 1인분 영양정보가 등록되어 있어야 목표 영양소에 맞춰 식단을 만들 수 있습니다. 왼쪽의 공공 메뉴 자료 버튼으로 원본 시트를 열 수 있습니다."/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource HelpRow}" Background="{StaticResource BrandTint}">
                                    <StackPanel>
                                        <TextBlock Text="내 데이터는 어디에 있나요?" FontWeight="Bold" FontSize="14"
                                                   Foreground="#2F5233"/>
                                        <TextBlock Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap"
                                                   Foreground="#2F5233"
                                                   Text="로그인한 구글 계정의 드라이브에 «나만의 스마트 식단 및 알러지 DB» 스프레드시트로 저장됩니다. 구글 시트에서 직접 열어 확인할 수 있습니다."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="2" Margin="0,20,0,0">
                            <Button x:Name="BtnReplayTutorial" Content="처음 안내 다시 보기"
                                    HorizontalAlignment="Left" MinWidth="170"
                                    Click="BtnReplayTutorial_Click"/>
                            <Button x:Name="BtnCloseHelp" Content="닫기" Width="110"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="BtnCloseHelp_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
