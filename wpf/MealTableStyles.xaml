<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="MealTableHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#EAF3ED"/>
        <Setter Property="Foreground" Value="#28523A"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="BorderBrush" Value="#D9E7DD"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
            <StackPanel><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#6C8773" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
        </DataTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MealTableRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="White"/>
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#F8FBF8"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F0F6F1"/></Trigger>
            <DataTrigger Binding="{Binding Category}" Value="총 열량"><Setter Property="Background" Value="#EAF3ED"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="MealTableCell" TargetType="DataGridCell">
        <Setter Property="Foreground" Value="#294536"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
            <Border x:Name="Outline" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="8" Margin="3,4" Padding="10,8">
                <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Outline" Property="Background" Value="#DFEEE2"/><Setter TargetName="Outline" Property="BorderBrush" Value="#4D8961"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="#286A47"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
