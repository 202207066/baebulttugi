<Page x:Class="wpf.Ingredients"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:wpf"
      mc:Ignorable="d" 
      Title="Ingredients" Height="650" Width="950"
      Background="#F5F6FA">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="메뉴 및 식재료 DB 관리" FontSize="24" FontWeight="Bold" Foreground="#1A202C"/>
                <TextBlock Text="구글 스프레드시트 및 CSV 파일을 통해 로컬 DB 성분을 동기화하고 조회합니다." FontSize="12" Foreground="#A0AEC0" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="10" Padding="20" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnSelectFile" Grid.Column="0" Content="📁 CSV 파일 선택" Click="btnSelectFile_Click"
                        Height="40" Padding="15,0" Background="#EDF2F7" BorderThickness="0" 
                        Foreground="#4A5568" FontWeight="SemiBold" Margin="0,0,15,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBox x:Name="txtFilePath" Grid.Column="1" Text="선택된 파일이 없습니다." IsReadOnly="True" 
                         VerticalContentAlignment="Center" Padding="15,0" FontSize="13" Foreground="#718096"
                         Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,15,0">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <Button x:Name="btnUpload" Grid.Column="2" Content="📤 시트에 업로드" Click="btnUpload_Click"
                        Height="40" Padding="20,0" Background="#3182CE" BorderThickness="0" 
                        Foreground="White" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📄 선택된 시트:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,8,0"/>
                <ComboBox x:Name="cmbSheets" Width="150" Height="40" VerticalContentAlignment="Center" Margin="0,0,20,0" FontSize="13" Foreground="#2D3748"
                          SelectionChanged="cmbSheets_SelectionChanged">
                    <ComboBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>

                <TextBlock Text="🔍 필터 검색:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,8,0"/>
                <TextBox x:Name="txtFilterKeyword" Width="320" Height="40" VerticalContentAlignment="Center" Padding="10,0" FontSize="13" Foreground="#2D3748"
                         Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,20,0"
                         TextChanged="txtFilterKeyword_TextChanged">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <Button x:Name="btnSaveChanges" Content="💾 변경사항 저장" Click="btnSaveChanges_Click"
                        Height="40" Padding="18,0" Background="#38A169" BorderThickness="0" 
                        Foreground="White" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="10" Padding="25" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="📊 음식 재료 및 성분 분석 목록" FontSize="16" 
                               FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
                    <Border Background="#EBF8FF" CornerRadius="12" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="실시간 동기화 데이터" FontSize="11" FontWeight="Bold" Foreground="#2B6CB0"/>
                    </Border>
                </StackPanel>

                <DataGrid Grid.Row="1" x:Name="dataGridIngredients" AutoGenerateColumns="True"
                          Background="White" RowHeight="38" IsReadOnly="False" CanUserAddRows="True" CanUserDeleteRows="True" 
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F7" AlternatingRowBackground="#F7FAFC" 
                          FontSize="13" Foreground="#2D3748" BorderBrush="#E2E8F0" BorderThickness="1"
                          HeadersVisibility="Column">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#EDF2F7"/>
                            <Setter Property="Foreground" Value="#4A5568"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EBF8FF"/>
                                    <Setter Property="Foreground" Value="#2B6CB0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>