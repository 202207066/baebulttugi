<Page x:Class="wpf.Ingredients"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:wpf"
      mc:Ignorable="d" 
      Title="Ingredients"
      Background="#F4F7F3">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="메뉴 및 식재료 DB 관리" FontSize="24" FontWeight="Bold" Foreground="#294334"/>
                <TextBlock Text="CSV 파일을 가져오거나 선택한 급식소의 메뉴·식재료 자료를 확인하고 수정하세요." FontSize="12" Foreground="#7E9585" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="18" Padding="20" Margin="0,0,0,15" BorderBrush="#DCE7DE" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnSelectFile" Grid.Column="0" Content="📁 CSV 파일 선택" Click="btnSelectFile_Click"
                        Height="Auto" Padding="15,0" Background="#EAF2EB" BorderThickness="0" 
                        Foreground="#416449" FontWeight="SemiBold" Margin="0,0,15,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBox x:Name="txtFilePath" Grid.Column="1" Text="선택된 파일이 없습니다." IsReadOnly="True" 
                         VerticalContentAlignment="Center" Padding="15,0" FontSize="13" Foreground="#718096"
                         Background="#F6F9F5" BorderBrush="#DCE7DE" BorderThickness="1" Margin="0,0,15,0">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <Button x:Name="btnUpload" Grid.Column="2" Content="📤 시트에 업로드" Click="btnUpload_Click"
                        Height="Auto" Padding="20,0" Background="#2E7D32" BorderThickness="0" 
                        Foreground="White" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,15">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="📄 선택된 시트:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#416449" Margin="0,0,8,0"/>
                <ComboBox x:Name="cmbSheets" Width="160" Height="40" VerticalContentAlignment="Center" Margin="0,0,15,0" FontSize="13" Foreground="#294334"
                          SelectionChanged="cmbSheets_SelectionChanged">
                    <ComboBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>

                <TextBox x:Name="txtNewSheetName" Width="150" Height="40" VerticalContentAlignment="Center" Padding="10,0" FontSize="13" Foreground="#294334"
                         Background="#FFFFFF" BorderBrush="#DCE7DE" BorderThickness="1" Margin="0,0,5,0">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                <Button x:Name="btnCreateSheet" Content="➕ 시트 추가" Click="btnCreateSheet_Click"
                        Height="Auto" Padding="12,0" Background="#416449" BorderThickness="0" 
                        Foreground="White" FontWeight="Bold" Margin="0,0,25,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock Text="🔍 필터 검색:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#416449" Margin="0,0,8,0"/>
                <TextBox x:Name="txtFilterKeyword" Width="260" Height="40" VerticalContentAlignment="Center" Padding="10,0" FontSize="13" Foreground="#294334"
                         Background="#FFFFFF" BorderBrush="#DCE7DE" BorderThickness="1"
                         TextChanged="txtFilterKeyword_TextChanged">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,20">
            <WrapPanel VerticalAlignment="Center">
                <Button x:Name="btnAddRow" Content="➕ 행 추가" Click="btnAddRow_Click"
                        Height="Auto" Padding="18,0" Background="#416449" BorderThickness="0" 
                        Foreground="White" FontWeight="Bold" Margin="0,0,10,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btnDeleteRow" Content="➖ 선택행 삭제" Click="btnDeleteRow_Click"
                        Height="Auto" Padding="18,0" Background="#E53E3E" BorderThickness="0" 
                        Foreground="White" FontWeight="Bold" Margin="0,0,15,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btnSaveChanges" Content="💾 변경사항 저장" Click="btnSaveChanges_Click"
                        Height="Auto" Padding="20,0" Background="#2E7D32" BorderThickness="0" 
                        Foreground="White" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </WrapPanel>
        </Grid>

        <Border Grid.Row="4" Background="#FFFFFF" CornerRadius="18" Padding="25" BorderBrush="#DCE7DE" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="📊 음식 재료 및 성분 분석 목록" FontSize="16" 
                               FontWeight="Bold" Foreground="#294334" VerticalAlignment="Center"/>
                    <Border Background="#EAF3EB" CornerRadius="12" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="급식소 자료" FontSize="11" FontWeight="Bold" Foreground="#2E683B"/>
                    </Border>
                </StackPanel>

                <DataGrid Grid.Row="1" x:Name="dataGridIngredients" AutoGenerateColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          Background="White" RowHeight="38" IsReadOnly="False" CanUserAddRows="True" CanUserDeleteRows="True" 
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EAF2EB" AlternatingRowBackground="#F6F9F5" 
                          FontSize="13" Foreground="#294334" BorderBrush="#DCE7DE" BorderThickness="1"
                          HeadersVisibility="Column">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#EAF2EB"/>
                            <Setter Property="Foreground" Value="#416449"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#DCE7DE"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EAF3EB"/>
                                    <Setter Property="Foreground" Value="#2E683B"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>