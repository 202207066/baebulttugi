<Page x:Class="test1.ingredients"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ingredients" Height="650" Width="950"
      Background="#F9F9F9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="LightGray" BlurRadius="5" Direction="270" ShadowDepth="1"/>
            </Border.Effect>
            <DockPanel>
                <Button x:Name="btnSelectFile" Content="📁 CSV 파일 선택" Click="btnSelectFile_Click"
                        Width="157" Height="35" Background="#ECEFF1" BorderBrush="#B0BEC5" 
                        Foreground="#37474F" FontWeight="Bold" Margin="0,0,15,0"/>
                <TextBox x:Name="txtFilePath" Text="선택된 파일이 없습니다." IsReadOnly="True" 
                         VerticalContentAlignment="Center" Padding="10,0" FontSize="13"
                         Background="#F5F5F5" BorderBrush="#CFD8DC"/>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <Button x:Name="btnUpload" Content="📤 시트에 업로드" Click="btnUpload_Click"
                    Width="147" Height="38" Background="#673AB7" BorderBrush="#673AB7" 
                    Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>

            <Button x:Name="btnLoadGoogleSheet" Content="🌐 구글시트불러오기" Click="btnLoadGoogleSheet_Click"
                    Width="172" Height="38" Background="#2196F3" BorderBrush="#2196F3" 
                    Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>

            <Button x:Name="btnSearch" Content="🔍 조회" Click="btnSearch_Click"
                    Width="100" Height="38" Background="#4CAF50" BorderBrush="#4CAF50" 
                    Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>

            <Button x:Name="btnFilter" Content="⏳ 필터 적용" Click="btnFilter_Click"
                    Width="126" Height="38" Background="#FF9800" BorderBrush="#FF9800" 
                    Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15">
            <Border.Effect>
                <DropShadowEffect Color="LightGray" BlurRadius="8" Direction="315" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="📊 음식 재료 및 성분 분석 목록" FontSize="14" 
                           FontWeight="Bold" Foreground="#455A64" Margin="0,0,0,10"/>

                <DataGrid Grid.Row="1" x:Name="dataGridIngredients" AutoGenerateColumns="True"
                          Background="White" RowHeight="32" IsReadOnly="True" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#CCCCCC" VerticalGridLinesBrush="#CCCCCC"
                          AlternatingRowBackground="#F9F9F9" FontSize="13" BorderBrush="#E0E0E0"/>
            </Grid>
        </Border>
    </Grid>
</Page>