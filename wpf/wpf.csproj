<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>wpf</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    비밀정보 파일은 저장소에 커밋하지 않습니다(.gitignore 참고).
    배포 기본 설정과 데스크톱 OAuth 설정은 빌드에 포함합니다. 사용자는 JSON을 준비하지 않습니다.
  -->
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" Condition="Exists('appsettings.json')" />
    <None Update="credentials.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" Condition="Exists('credentials.json')" />
    <EmbeddedResource Include="$(IntermediateOutputPath)deployment/appsettings.json" LogicalName="wpf.DeploymentSettings" />
    <EmbeddedResource Include="$(IntermediateOutputPath)deployment/credentials.json" LogicalName="wpf.DesktopOAuth" />
    <None Update="appsettings.sample.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis" Version="1.76.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.76.0" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.76.0.4252" />
    <PackageReference Include="Google.Apis.Sheets.v4" Version="1.75.0.4178" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup><EmbeddedResource Include="RecipePortions.json" LogicalName="wpf.RecipePortions"/></ItemGroup>
  <Target Name="PrepareDeploymentSettings" BeforeTargets="PrepareResourceNames">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/Deployment/Prepare-Settings.ps1&quot; -SourceDirectory &quot;$(MSBuildProjectDirectory)&quot; -OutputDirectory &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)deployment&quot;" />
  </Target>
  <ItemGroup>
    <None Update="token.json/**;GoogleSignIn/**;user_sheet_id.txt;userprefs.json;Deployment/**" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
