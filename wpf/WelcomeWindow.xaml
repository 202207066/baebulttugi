<Window x:Class="wpf.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="배불뚝이 시작하기"
        Height="620" Width="920"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource Surface}"
        FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── 왼쪽: 브랜드 + 진행 단계 ───────────────────────────── -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                    <GradientStop Color="{StaticResource BrandColor}" Offset="0"/>
                    <GradientStop Color="{StaticResource BrandDeepColor}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="36,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 로고 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Canvas Width="44" Height="44" Margin="0,0,12,0">
                        <Path Fill="{StaticResource LimeSoft}"
                              Data="M22,20 C22,14 22,10 22,6"
                              Stroke="{StaticResource LimeSoft}" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Ellipse Canvas.Left="23" Canvas.Top="4" Width="16" Height="9"
                                 Fill="{StaticResource LimeSoft}">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-25" CenterX="8" CenterY="4.5"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Path Fill="White" Data="M8,24 A14,8 0 0 1 36,24 Z"/>
                        <Path Fill="White" Data="M4,24 A18,18 0 0 0 40,24 Z" Opacity="0.92"/>
                    </Canvas>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="배불뚝이" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="SMART MEAL CARE" FontSize="10" Foreground="#BFE0C2"
                                   Margin="1,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 단계 목록 -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <StackPanel x:Name="StepItem1" Orientation="Horizontal" Margin="0,0,0,26">
                        <Ellipse x:Name="Dot1" Width="10" Height="10" Fill="White"
                                 VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock x:Name="StepLabel1" Text="왜 구글 로그인인가요?"
                                   FontSize="15" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="StepItem2" Orientation="Horizontal" Margin="0,0,0,26">
                        <Ellipse x:Name="Dot2" Width="10" Height="10" Fill="#6E9A72"
                                 VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock x:Name="StepLabel2" Text="내 드라이브에 DB가 생깁니다"
                                   FontSize="15" Foreground="#BFE0C2" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="StepItem3" Orientation="Horizontal">
                        <Ellipse x:Name="Dot3" Width="10" Height="10" Fill="#6E9A72"
                                 VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock x:Name="StepLabel3" Text="데이터는 내 계정 안에만"
                                   FontSize="15" Foreground="#BFE0C2" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="2" TextWrapping="Wrap" FontSize="11.5"
                           Foreground="#9FC7A4" LineHeight="18"
                           Text="취약계층 급식소를 위한 스마트 식단 및 알러지 케어 솔루션"/>
            </Grid>
        </Border>

        <!-- ── 오른쪽: 단계 내용 ──────────────────────────────────── -->
        <Grid Grid.Column="1" Margin="48,40,48,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="TxtStepCounter" Text="1 / 3"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource Brand}" Margin="0,0,0,10"/>

            <StackPanel Grid.Row="1">
                <TextBlock x:Name="TxtStepTitle"
                           Text="설치도, 회원가입도 없습니다"
                           FontSize="27" FontWeight="Bold"
                           Foreground="{StaticResource Ink}"
                           TextWrapping="Wrap" Margin="0,0,0,18"/>

                <TextBlock x:Name="TxtStepBody"
                           FontSize="14.5" LineHeight="26"
                           Foreground="{StaticResource InkMuted}"
                           TextWrapping="Wrap" Margin="0,0,0,24"/>

                <Border x:Name="HighlightBox" Style="{StaticResource Card}"
                        Background="{StaticResource BrandTint}"
                        BorderBrush="#CFE3D1" Padding="18" Effect="{x:Null}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtHighlightIcon" Text="🔒" FontSize="20"
                                   Margin="0,0,14,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="TxtHighlight"
                                   FontSize="13.5" LineHeight="22"
                                   Foreground="#2F5233" TextWrapping="Wrap"
                                   MaxWidth="400"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 하단 버튼 -->
            <Grid Grid.Row="2">
                <Button x:Name="BtnSkip" Content="건너뛰기"
                        Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left" Click="BtnSkip_Click"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnPrev" Content="이전" Width="92"
                            Margin="0,0,10,0" Click="BtnPrev_Click"/>
                    <Button x:Name="BtnNext" Content="다음" Width="130"
                            Style="{StaticResource PrimaryButton}" Click="BtnNext_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
