<Page x:Class="wpf.CalculatePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F7F3" Foreground="#263E2F" FontSize="14" FontFamily="{StaticResource UiFont}">
<Page.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PlannerStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Page.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28" x:Name="EditorRoot">
<TextBlock Text="원가 · 소요량 계산" FontSize="26" FontWeight="Bold"/><TextBlock Text="저장된 식단을 선택하고 실제 구매 단가를 입력하세요. 레시피의 1인분 분량으로 필요한 양과 원가를 계산합니다." TextWrapping="Wrap" Margin="0,8,0,16"/>
<Border Style="{StaticResource PlannerCard}"><StackPanel><WrapPanel>
<StackPanel Width="350" Margin="0,0,18,12"><TextBlock Text="저장된 식단" Margin="0,0,0,6"/><ComboBox x:Name="cbTargetMenu" SelectionChanged="MenuChanged"/></StackPanel>
<StackPanel Width="130" Margin="0,0,18,12"><TextBlock Text="식사 인원 (명)" Margin="0,0,0,6"/><TextBox x:Name="txtHeadCount" TextChanged="InputsChanged"/></StackPanel>
<StackPanel Width="170" Margin="0,0,18,12"><TextBlock Text="인당 목표 급식비 (원)" Margin="0,0,0,6"/><TextBox x:Name="txtBudgetPerPerson" Text="5000" TextChanged="InputsChanged"/></StackPanel>
<Button Content="식단 새로고침" Click="Refresh_Click" Margin="0,22,0,12"/>
</WrapPanel><TextBlock x:Name="TxtDataStatus" Text="저장된 식단을 확인하고 있습니다." TextWrapping="Wrap"/><TextBlock x:Name="MealSummary" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
<Border Style="{StaticResource PlannerCard}"><StackPanel>
<TextBlock Text="1인분 재료와 구매 단가" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="예: 소요량 40 g, 구매가격 3,000원 / 기준량 1 kg. 빈 단가는 0원으로 계산하지 않습니다. 재료 행의 출처는 마우스를 올려 확인하세요." TextWrapping="Wrap" Margin="0,8,0,12"/>
<DataGrid x:Name="CostInputs" AutoGenerateColumns="False" Height="340" CanUserAddRows="True" CanUserDeleteRows="True" HorizontalScrollBarVisibility="Auto" CellEditEnding="CostEdited" EnableRowVirtualization="True" EnableColumnVirtualization="True">
<DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Source}"/></Style></DataGrid.RowStyle>
<DataGrid.Columns><DataGridTextColumn Header="메뉴 · 열량" Binding="{Binding DisplayMenu, Mode=OneWay}" Width="220" IsReadOnly="True"/><DataGridTextColumn Header="식재료" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="70"/><DataGridTextColumn Header="1인분 소요량" Binding="{Binding Amount}" Width="100"/><DataGridTextColumn Header="단위" Binding="{Binding Unit}" Width="60"/><DataGridTextColumn Header="구매가격(원)" Binding="{Binding Price}" Width="105"/><DataGridTextColumn Header="기준량" Binding="{Binding PriceQuantity}" Width="70"/><DataGridTextColumn Header="가격 단위" Binding="{Binding PriceUnit}" Width="80"/></DataGrid.Columns></DataGrid>
<WrapPanel Margin="0,14,0,0"><Button Content="재료·단가 저장" Click="SaveCosts_Click" Margin="0,0,12,8"/><Button x:Name="btnRunCalculate" Content="원가 계산하기" Click="btnRunCalculate_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,12,8"/></WrapPanel>
</StackPanel></Border>
<Border Style="{StaticResource PlannerCard}"><StackPanel>
<TextBlock Text="원재료 CSV 검색" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="구매처·식자재 업체에서 받은 CSV를 불러오면 원재료명을 검색할 수 있습니다. CSV 파일 자체는 개인 시트에 자동 저장하지 않습니다." TextWrapping="Wrap" Margin="0,8,0,12"/>
<WrapPanel><Button Content="원재료 CSV 불러오기" Click="ImportIngredientCsv_Click" Margin="0,0,12,8"/><TextBox x:Name="TxtIngredientSearch" Width="300" TextChanged="IngredientSearchChanged" ToolTip="원재료명 검색"/></WrapPanel>
<TextBlock x:Name="IngredientSearchStatus" Text="CSV를 불러오면 원재료명을 검색할 수 있습니다." Margin="0,4,0,8" Foreground="#718276"/>
<DataGrid x:Name="IngredientSearchGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="190" CanUserAddRows="False" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="원재료명" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="상품·규격" Binding="{Binding Product}" Width="2*"/><DataGridTextColumn Header="단위" Binding="{Binding Unit}" Width="*"/><DataGridTextColumn Header="단가" Binding="{Binding Price}" Width="*"/><DataGridTextColumn Header="파일" Binding="{Binding Source}" Width="2*"/></DataGrid.Columns></DataGrid>
</StackPanel></Border>
<Border Style="{StaticResource PlannerCard}"><StackPanel><TextBlock Text="계산 결과" FontSize="18" FontWeight="SemiBold"/><WrapPanel Margin="0,12,0,12"><TextBlock x:Name="txtTotalCount" Text="재료 —" Margin="0,0,24,8"/><TextBlock x:Name="txtCostPerPerson" Text="1인당 —" Margin="0,0,24,8"/><TextBlock x:Name="txtTotalCost" Text="총 원가 —" Margin="0,0,24,8"/></WrapPanel>
<DataGrid x:Name="dgCalculationResult" AutoGenerateColumns="False" IsReadOnly="True" Height="260" CanUserAddRows="False" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="식재료명" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="1인당 소요량" Binding="{Binding UnitWeightDisplay}" Width="*"/><DataGridTextColumn Header="총 소요량" Binding="{Binding TotalWeightDisplay}" Width="*"/><DataGridTextColumn Header="단가 / 기준량" Binding="{Binding UnitPriceDisplay}" Width="*"/><DataGridTextColumn Header="총 소요금액" Binding="{Binding TotalPriceDisplay}" Width="*"/></DataGrid.Columns></DataGrid>
<Button Content="계산 결과 CSV 저장" Click="btnExportExcel_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border>
</StackPanel></ScrollViewer></Page>
