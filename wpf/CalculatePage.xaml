<Page x:Class="wpf.CalculatePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:wpf" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F7F3" Foreground="#263E2F" FontSize="14" FontFamily="{StaticResource UiFont}">
<Page.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PlannerStyles.xaml"/></ResourceDictionary.MergedDictionaries><local:RepeatedMenuLabelConverter x:Key="MenuLabelConverter"/></ResourceDictionary></Page.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28" x:Name="EditorRoot">
<TextBlock Text="원가 · 소요량 계산" FontSize="26" FontWeight="Bold"/><TextBlock Text="식단과 식수를 선택하고 구매 기준을 입력하세요. 재료별 1인분 비용과 한 끼 원가를 자동 계산한 뒤 함께 저장할 수 있습니다." TextWrapping="Wrap" Margin="0,8,0,16"/>
<Border Style="{StaticResource PlannerCard}"><StackPanel><WrapPanel>
<StackPanel Width="350" Margin="0,0,18,12"><TextBlock Text="저장된 식단" Margin="0,0,0,6"/><ComboBox x:Name="cbTargetMenu" SelectionChanged="MenuChanged"/></StackPanel>
<StackPanel Width="130" Margin="0,0,18,12"><TextBlock Text="식사 인원 (명)" Margin="0,0,0,6"/><TextBox x:Name="txtHeadCount" TextChanged="InputsChanged"/></StackPanel>
<StackPanel Width="170" Margin="0,0,18,12"><TextBlock Text="인당 목표 급식비 (원)" Margin="0,0,0,6"/><TextBox x:Name="txtBudgetPerPerson" Text="5000" TextChanged="InputsChanged"/></StackPanel>
<Button Content="원가 기준 입력 · 엑셀" Click="OpenStandards_Click" Margin="0,22,12,12"/><Button Content="식단 새로고침" Click="Refresh_Click" Margin="0,22,0,12"/>
</WrapPanel><TextBlock x:Name="TxtDataStatus" Text="저장된 식단을 확인하고 있습니다." TextWrapping="Wrap"/><TextBlock x:Name="MealSummary" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
<Border Style="{StaticResource PlannerCard}"><StackPanel>
<TextBlock Text="원가 기준 입력 · 정미량과 구매 기준" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="정미량은 레시피에서 불러오며 수정할 수 있습니다. 구매가격·가격 기준량·단위·폐기율을 입력하고, 개·봉으로 사면 1개 중량(g)도 입력하세요. 폐기율 10은 10%이며, 폐기 없음은 0입니다. 같은 재료의 구매 기준은 모든 메뉴에 공통 적용됩니다. 입력 후 셀을 벗어나면 아래 계산 결과가 갱신됩니다." TextWrapping="Wrap" Margin="0,8,0,12"/>
<Expander Header="계산식과 입력 예시 보기" Margin="0,0,0,14"><Border Background="#EDF4EA" Padding="14" Margin="0,8,0,0"><StackPanel>
<TextBlock Text="① 1인분 구매량 = 정미량 ÷ (1 − 폐기율/100)   ② g당 단가 = 구매가격 ÷ g으로 환산한 구매 기준량" TextWrapping="Wrap" Margin="0,0,0,7"/>
<TextBlock Text="③ 1인분 재료비 = 1인분 구매량 × g당 단가   ④ 한 끼 1인당 원가 = 모든 재료의 1인분 재료비 합계" TextWrapping="Wrap" Margin="0,0,0,7"/>
<TextBlock Text="⑤ 총 원가 = 한 끼 1인당 원가 × 식수   ⑥ 발주량 = 1인분 구매량 × 식수" TextWrapping="Wrap" Margin="0,0,0,7"/>
<TextBlock Text="예: 양파 정미량 90g / 폐기율 10% / 1kg에 2,000원 / 식수 30명 → 1인분 구매량 100g, g당 2원, 1인분 재료비 200원, 발주량 3,000g, 총 6,000원." TextWrapping="Wrap" FontWeight="SemiBold"/>
<TextBlock Text="구매 기준이 30개, 개당 중량이 60g이면 기준량은 1,800g입니다. 액체는 ml·L 기준으로 계산하며 g과 임의로 같다고 보지 않습니다." TextWrapping="Wrap" Margin="0,8,0,0"/>
</StackPanel></Border></Expander>
<DataGrid x:Name="CostInputs" AutoGenerateColumns="False" MinHeight="340" MaxHeight="620" CanUserAddRows="True" CanUserDeleteRows="True" HorizontalScrollBarVisibility="Auto" CellEditEnding="CostEdited" EnableRowVirtualization="True" EnableColumnVirtualization="True">
<DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Source}"/></Style></DataGrid.RowStyle>
<DataGrid.Columns><DataGridTemplateColumn Header="메뉴 · 열량" Width="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock TextWrapping="Wrap"><TextBlock.Text><MultiBinding Converter="{StaticResource MenuLabelConverter}"><Binding Path="DisplayMenu"/><Binding Path="DisplayMenu" RelativeSource="{RelativeSource PreviousData}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox ItemsSource="{Binding Tag,RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding Menu,UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn><DataGridTextColumn Header="식재료" Binding="{Binding Name}" Width="200"/><DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="60"/><DataGridTextColumn Header="1인분 정미량" Binding="{Binding Amount}" Width="100"/><DataGridTextColumn Header="단위" Binding="{Binding Unit}" Width="60"/><DataGridTextColumn Header="구매가격(원)" Binding="{Binding Price}" Width="105"/><DataGridTextColumn Header="기준량" Binding="{Binding PriceQuantity}" Width="70"/><DataGridTextColumn Header="가격 단위" Binding="{Binding PriceUnit}" Width="80"/><DataGridTextColumn Header="폐기율(%)" Binding="{Binding WastePercent}" Width="95"/><DataGridTextColumn Header="개·봉당 중량(g)" Binding="{Binding PackageWeightGrams}" Width="130"/></DataGrid.Columns></DataGrid>
<WrapPanel Margin="0,14,0,0"><Button Content="재료·기준값만 저장" Click="SaveCosts_Click" Margin="0,0,12,8"/><Button x:Name="btnRunCalculate" Content="계산 미리보기" Click="btnRunCalculate_Click" Margin="0,0,12,8"/><Button x:Name="SaveCalculationButton" Content="한 끼 원가 계산·저장" Click="SaveCalculation_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,12,8"/></WrapPanel>
</StackPanel></Border>
<Border Style="{StaticResource PlannerCard}"><StackPanel><TextBlock Text="재료별 계산 결과와 한 끼 원가" FontSize="18" FontWeight="SemiBold"/><WrapPanel Margin="0,12,0,12"><TextBlock x:Name="txtTotalCount" Text="재료 —" Margin="0,0,24,8"/><TextBlock x:Name="txtCostPerPerson" Text="1인당 —" Margin="0,0,24,8"/><TextBlock x:Name="txtTotalCost" Text="총 원가 —" Margin="0,0,24,8"/></WrapPanel>
<Grid><DataGrid x:Name="dgCalculationResult" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="260" MaxHeight="520" CanUserAddRows="False" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="메뉴" Binding="{Binding Menu}" Width="115"/><DataGridTextColumn Header="식재료명" Binding="{Binding Name}" Width="130"/><DataGridTextColumn Header="1인분 정미량" Binding="{Binding UnitWeightDisplay}" Width="105"/><DataGridTextColumn Header="폐기율" Binding="{Binding WasteDisplay}" Width="80"/><DataGridTextColumn Header="1인분 구매량" Binding="{Binding GrossWeightDisplay}" Width="110"/><DataGridTextColumn Header="환산 기준량" Binding="{Binding PurchaseBasisDisplay}" Width="105"/><DataGridTextColumn Header="g·ml당 단가" Binding="{Binding BaseUnitPriceDisplay}" Width="110"/><DataGridTextColumn Header="1인분 재료비" Binding="{Binding PerPersonCostDisplay}" Width="120"/><DataGridTextColumn Header="발주량" Binding="{Binding TotalWeightDisplay}" Width="110"/><DataGridTextColumn Header="재료 총 원가" Binding="{Binding TotalPriceDisplay}" Width="120"/></DataGrid.Columns></DataGrid><TextBlock Text="입력값을 채우면 계산됩니다. 누락된 값은 화면 위 안내를 확인해 주세요." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8A9B8D" IsHitTestVisible="False" TextWrapping="Wrap" TextAlignment="Center" Margin="20,45,20,20"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count,ElementName=dgCalculationResult}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
<TextBlock x:Name="CalculationSaveStatus" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="#315D40"/><Button Content="계산 결과 CSV 저장" Click="btnExportExcel_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border>
<Border Style="{StaticResource PlannerCard}"><StackPanel>
<TextBlock Text="원재료 CSV 검색" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="구매처·식자재 업체에서 받은 CSV를 불러오면 원재료명을 검색할 수 있습니다. CSV 파일 자체는 개인 시트에 자동 저장하지 않습니다." TextWrapping="Wrap" Margin="0,8,0,12"/>
<WrapPanel><Button Content="원재료 CSV 불러오기" Click="ImportIngredientCsv_Click" Margin="0,0,12,8"/><TextBox x:Name="TxtIngredientSearch" Width="300" TextChanged="IngredientSearchChanged" ToolTip="원재료명 검색"/></WrapPanel>
<TextBlock x:Name="IngredientSearchStatus" Text="CSV를 불러오면 원재료명을 검색할 수 있습니다." Margin="0,4,0,8" Foreground="#718276"/>
<Grid><DataGrid x:Name="IngredientSearchGrid" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="190" MaxHeight="420" CanUserAddRows="False" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="원재료명" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="상품·규격" Binding="{Binding Product}" Width="2*"/><DataGridTextColumn Header="단위" Binding="{Binding Unit}" Width="*"/><DataGridTextColumn Header="단가" Binding="{Binding Price}" Width="*"/><DataGridTextColumn Header="파일" Binding="{Binding Source}" Width="2*"/></DataGrid.Columns></DataGrid><TextBlock Text="CSV를 불러오면 원재료명을 검색할 수 있습니다." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8A9B8D" IsHitTestVisible="False" TextWrapping="Wrap" TextAlignment="Center" Margin="20,45,20,20"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count,ElementName=IngredientSearchGrid}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
</StackPanel></Border>
</StackPanel></ScrollViewer></Page>
