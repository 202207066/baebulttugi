<Page x:Class="wpf.DatabaseSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:wpf"
      mc:Ignorable="d"
      Title="DatabaseSettingsPage"
      Background="{StaticResource Canvas}"
      FontFamily="{StaticResource UiFont}">

    <Page.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
            <Setter Property="Margin" Value="2,0,0,7"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,26,32,32" MaxWidth="1000" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 머리말 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,22">
                <TextBlock Text="데이터베이스 설정" Style="{StaticResource PageTitle}"/>
                <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource InkSubtle}"
                           TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"
                           Text="이 프로그램의 모든 데이터는 구글 스프레드시트에 저장됩니다. 급식소마다 자기 시트를 쓰게 되므로, 여기서 새로 만들거나 이미 쓰던 시트에 연결할 수 있습니다."/>
            </StackPanel>

            <!-- ── 현재 연결 ─────────────────────────────────────── -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse x:Name="DotStatus" Width="9" Height="9"
                                     Fill="{StaticResource Lime}" VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>
                            <TextBlock Text="현재 연결된 데이터베이스" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource InkSubtle}"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtCurrentTitle" Text="확인하는 중…"
                                   FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock x:Name="TxtCurrentId" Text=""
                                   FontSize="11.5" Foreground="{StaticResource InkFaint}"
                                   Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>

                        <TextBlock x:Name="TxtCurrentNote" Text="" Margin="0,10,0,0"
                                   FontSize="12.5" Foreground="{StaticResource Warning}"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="BtnOpenInBrowser" Content="구글 시트에서 열기"
                                Width="150" Click="BtnOpenInBrowser_Click"/>
                        <Button x:Name="BtnRefresh" Content="새로고침" Width="96"
                                Margin="8,0,0,0" Click="BtnRefresh_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── 시트(탭) 상태 ─────────────────────────────────── -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,18">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="필요한 시트(탭)" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}"
                                       Text="앱이 읽고 쓰는 탭입니다. 없으면 헤더까지 갖춰 자동으로 만들 수 있습니다."/>
                        </StackPanel>

                        <Button x:Name="BtnEnsureSheets" Content="없는 탭 만들기" Width="140"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Click="BtnEnsureSheets_Click"/>
                    </Grid>

                    <ItemsControl x:Name="ListSheets">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CanvasSoft}" CornerRadius="9"
                                        Padding="14,11" Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="14"
                                                   Margin="0,0,11,0" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13.5"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                            <TextBlock Text="{Binding Purpose}" FontSize="11.5"
                                                       Foreground="{StaticResource InkSubtle}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="{Binding StatusColor}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ── 다른 DB 연결 / 새로 만들기 ─────────────────────── -->
            <Grid Grid.Row="3" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 기존 시트 연결 -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="이미 쓰던 시트에 연결" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"
                                   Text="구글 시트 주소를 그대로 붙여넣으세요. 로그인한 계정에 편집 권한이 있어야 합니다."/>

                        <TextBlock Text="스프레드시트 주소 또는 ID" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtSheetUrl" Height="40"
                                 ToolTip="https://docs.google.com/spreadsheets/d/..../edit"/>

                        <TextBlock x:Name="TxtConnectResult" Margin="2,10,0,0" FontSize="12.5"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>

                        <Button x:Name="BtnConnect" Content="연결하기" Margin="0,16,0,0"
                                HorizontalAlignment="Left" Width="128"
                                Style="{StaticResource PrimaryButton}" Click="BtnConnect_Click"/>
                    </StackPanel>
                </Border>

                <!-- 새로 만들기 -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="새 데이터베이스 만들기" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"
                                   Text="기본 템플릿을 복사해 내 드라이브에 새 스프레드시트를 만듭니다. 새 급식소를 추가할 때 쓰세요."/>

                        <TextBlock Text="파일 이름" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtNewName" Height="40"
                                 Text="스마트 식단 및 알러지 DB"/>

                        <TextBlock x:Name="TxtCreateResult" Margin="2,10,0,0" FontSize="12.5"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>

                        <Button x:Name="BtnCreate" Content="만들고 연결" Margin="0,16,0,0"
                                HorizontalAlignment="Left" Width="128"
                                Style="{StaticResource PrimaryButton}" Click="BtnCreate_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── 최근 사용 ─────────────────────────────────────── -->
            <Border Grid.Row="4" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="최근 사용한 데이터베이스" Style="{StaticResource SectionTitle}"/>

                    <TextBlock x:Name="TxtNoRecent" Style="{StaticResource Caption}"
                               Text="아직 연결한 기록이 없습니다."
                               Visibility="Collapsed" Margin="2,0,0,0"/>

                    <ItemsControl x:Name="ListRecent">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CanvasSoft}" CornerRadius="9"
                                        Padding="14,10" Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13.5"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ShortId}" FontSize="11"
                                                       Foreground="{StaticResource InkFaint}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="이 DB로 전환" Width="112"
                                                Tag="{Binding Id}" Click="BtnSwitchRecent_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
