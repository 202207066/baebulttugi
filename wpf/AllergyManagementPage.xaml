<Page x:Class="wpf.AllergyManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="알러지 케어 스마트 관리 센터" d:DesignHeight="768" d:DesignWidth="1116"
      Background="#F5F6FA">

    <Page.Resources>
        <Style x:Key="ModernCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="RoundedInputStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="15,10" Margin="0,0,10,0">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4A90E2"/>
                                <Setter Property="Foreground" Value="#4A90E2"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#718096"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,25">
            <StackPanel>
                <TextBlock Text="피급식자 및 알러지 케어 설정" FontSize="26" FontWeight="Bold" Foreground="#1A202C"/>
                <TextBlock Text="시스템 규칙 및 개별 알러지 성분을 분석하여 안전한 식단을 매칭합니다." FontSize="13" Foreground="#718096" Margin="2,4,0,0"/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <TabItem Header="👤 피급식자 등록 및 정보 변경" FontSize="15">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                                <TextBlock Text="성명" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,6" FontSize="13"/>
                                <Border Style="{StaticResource RoundedInputStyle}">
                                    <TextBox x:Name="TxtPatientName" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                                <TextBlock Text="대상 분류" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,6" FontSize="13"/>
                                <ComboBox x:Name="CmbPatientCategory" Height="36" Background="White" BorderBrush="#CBD5E0" Padding="8,0" VerticalContentAlignment="Center">
                                    <ComboBoxItem IsSelected="True">일반</ComboBoxItem>
                                    <ComboBoxItem>영유아</ComboBoxItem>
                                    <ComboBoxItem>고령자</ComboBoxItem>
                                    <ComboBoxItem>특별관리</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,0,0,15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="🛡️ 식약처 지정 알러지 유발 물질" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,8,6" FontSize="13"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <WrapPanel Orientation="Horizontal" ItemWidth="110" ItemHeight="30" Margin="0,5,0,0">
                                        <CheckBox Content="우유" Margin="0,2" Foreground="#2D3748"/>
                                        <CheckBox Content="달걀" Margin="0,2" Foreground="#2D3748"/>
                                        <CheckBox Content="땅콩" Margin="0,2" Foreground="#2D3748"/>
                                        <CheckBox Content="대두" Margin="0,2" Foreground="#2D3748"/>
                                        <CheckBox Content="밀" Margin="0,2" Foreground="#2D3748"/>
                                        <CheckBox Content="조개류" Margin="0,2" Foreground="#2D3748"/>
                                        <CheckBox Content="새우" Margin="0,2" Foreground="#2D3748"/>
                                        <CheckBox Content="게" Margin="0,2" Foreground="#2D3748"/>
                                        <CheckBox Content="고등어" Margin="0,2" Foreground="#2D3748"/>
                                        <CheckBox Content="굴" Margin="0,2" Foreground="#2D3748"/>
                                        <CheckBox Content="복숭아" Margin="0,2" Foreground="#2D3748"/>
                                        <CheckBox Content="호두" Margin="0,2" Foreground="#2D3748"/>
                                        <CheckBox Content="아몬드" Margin="0,2" Foreground="#2D3748"/>
                                        <CheckBox Content="참깨" Margin="0,2" Foreground="#2D3748"/>
                                        <CheckBox Content="소고기" Margin="0,2" Foreground="#2D3748"/>
                                        <CheckBox Content="닭고기" Margin="0,2" Foreground="#2D3748"/>
                                        <CheckBox Content="콩류(기타)" Margin="0,2" Foreground="#2D3748"/>
                                    </WrapPanel>
                                </ScrollViewer>
                            </Grid>

                            <StackPanel Grid.Row="3" Margin="0,0,0,20">
                                <TextBlock Text="선호 및 특이사항 메모" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,6" FontSize="13"/>
                                <Border CornerRadius="6" BorderBrush="#CBD5E0" BorderThickness="1" Background="White" Height="70">
                                    <TextBox x:Name="TxtPatientNote" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="8"/>
                                </Border>
                            </StackPanel>

                            <Button x:Name="BtnSavePatient" Grid.Row="4" Height="42" Background="#4A90E2" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾 신규 피급식자 DB 등록" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Padding="12" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource RoundedInputStyle}" Margin="0,0,8,0">
                                    <TextBox x:Name="TxtSearchPatient" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0" Tag="검색할 피급식자 이름을 입력하세요..."/>
                                </Border>
                                <Button x:Name="BtnSearchPatient" Grid.Column="1" Content="🔍 검색" Width="80" Height="36" Background="#4A5568" Foreground="White" FontWeight="SemiBold" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}" Padding="0" Margin="0,0,0,15" ClipToBounds="True">
                            <DataGrid x:Name="DgPatients" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F7" BorderThickness="0" Background="White" RowHeight="40" ColumnHeaderHeight="40">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F7FAFC"/>
                                        <Setter Property="Foreground" Value="#4A5568"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="15,0"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="15,0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="100"/>
                                    <DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="100"/>
                                    <DataGridTextColumn Header="특이 알러지 성분" Binding="{Binding Allergies}" Width="160"/>
                                    <DataGridTextColumn Header="메모" Binding="{Binding Note}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnUpdatePatient" Content="✏️ 정보 수정" Width="110" Height="38" Background="#EDF2F7" Foreground="#4A5568" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,8,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button x:Name="BtnDeletePatient" Content="🗑️ 명단 삭제" Width="110" Height="38" Background="#FFF5F5" Foreground="#E53E3E" FontWeight="SemiBold" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="🚨 실시간 식단 필터 모니터링" FontSize="15">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Padding="15" Margin="0,0,0,20">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="조회 일자" FontWeight="SemiBold" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13"/>
                                <DatePicker x:Name="DpMonitorDate" Height="36" Width="180" VerticalContentAlignment="Center" BorderBrush="#CBD5E0"/>
                                <Button x:Name="BtnScanAllergy" Margin="15,0,0,0" Padding="20,0" Height="36" Background="#E53E3E" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                    <TextBlock Text="⚡ 알러지 위험 요인 교차 스캔 프로세스 실행" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="60"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,0">
                                    <TextBlock Text="📋 당일 식단 메뉴 성분표" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center" FontSize="14"/>
                                </Border>
                                <DataGrid x:Name="DgDailyMenu" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" BorderThickness="0" Background="White" RowHeight="38" ColumnHeaderHeight="38">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="Foreground" Value="#718096"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="15,0"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="메뉴명" Binding="{Binding MenuName}" Width="130"/>
                                        <DataGridTextColumn Header="포함 성분 정보" Binding="{Binding Ingredients}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Row="2" Background="#F8FAFC" Padding="15,0">
                                    <Button x:Name="BtnManualMenuInput" Content="➕ 식단 메뉴 수동 임의 입력" Height="34" Background="White" BorderBrush="#CBD5E0" Foreground="#4A5568" FontWeight="SemiBold" Padding="15,0" HorizontalAlignment="Left">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource ModernCardStyle}" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="60"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#FFF5F5" BorderBrush="#FED7D7" BorderThickness="0,0,0,1" Padding="20,0">
                                    <TextBlock Text="⚠️ 알러지 자동 추출 및 대체 메뉴 매칭 제안" FontWeight="Bold" Foreground="#C53030" VerticalAlignment="Center" FontSize="14"/>
                                </Border>
                                <DataGrid x:Name="DgAllergicMatches" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" BorderThickness="0" Background="White" RowHeight="38" ColumnHeaderHeight="38">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="Foreground" Value="#718096"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="15,0"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="위험 대상자" Binding="{Binding PatientName}" Width="100"/>
                                        <DataGridTextColumn Header="제한 물질" Binding="{Binding RiskIngredients}" Width="120"/>
                                        <DataGridTextColumn Header="💡 제안하는 대체 메뉴" Binding="{Binding SuggestedAlternative}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Row="2" Background="#F8FAFC" Padding="15,0">
                                    <Button x:Name="BtnConfirmAlternativeMenu" Content="🔄 대체 식단 규칙 일괄 승인 및 확정" Height="36" Background="#38A169" BorderThickness="0" Foreground="White" FontWeight="Bold" Padding="20,0" HorizontalAlignment="Right">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>