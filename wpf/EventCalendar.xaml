<Page x:Class="wpf.EventCalendar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:wpf"
      mc:Ignorable="d"
      Title="EventCalendar"
      Background="{StaticResource Canvas}"
      FontFamily="{StaticResource UiFont}">

    <Page.Resources>

        <!-- 날짜 한 칸 -->
        <Style x:Key="DayButton" TargetType="CalendarDayButton">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="9" Background="Transparent"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- 일정이 있는 날 표시용 점 -->
                            <Ellipse x:Name="Dot" Width="5" Height="5" Margin="0,0,0,7"
                                     VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                     Fill="{StaticResource Lime}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandTint}"/>
                            </Trigger>
                            <Trigger Property="IsToday" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EDF5EE"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{StaticResource Brand}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brand}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Foreground" Value="#CBD5E0"/>
                            </Trigger>
                            <Trigger Property="IsBlackedOut" Value="True">
                                <Setter Property="Foreground" Value="#CBD5E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </Page.Resources>

    <Grid Margin="32,26,32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 머리말 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="이벤트 · 절기 달력" Style="{StaticResource PageTitle}"/>
            <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource InkSubtle}"
                       Text="공휴일과 절기를 자동으로 불러오고, 급식소 일정을 함께 관리합니다."/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- ══ 왼쪽: 달력 ══ -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 선택한 날짜 배너 -->
                    <Border Grid.Row="0" CornerRadius="12" Padding="22,18" Margin="0,0,0,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource BrandColor}" Offset="0"/>
                                <GradientStop Color="{StaticResource BrandDarkColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="txtBannerYear" Text=""
                                           FontSize="12" Foreground="#A8CFAD"/>
                                <TextBlock x:Name="txtSelectedDate" Text="날짜를 선택해주세요"
                                           FontSize="26" FontWeight="Bold" Foreground="White"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <Border x:Name="BadgeHoliday" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Visibility="Collapsed"
                                    Background="#FFFFFF" CornerRadius="16" Padding="14,7">
                                <TextBlock x:Name="txtBadgeHoliday" Text=""
                                           FontSize="12.5" FontWeight="Bold"
                                           Foreground="{StaticResource Brand}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Calendar Grid.Row="1" x:Name="MainCalendar"
                              HorizontalAlignment="Center" VerticalAlignment="Top"
                              BorderThickness="0" Background="Transparent"
                              FontSize="14"
                              CalendarDayButtonStyle="{StaticResource DayButton}"/>

                    <!-- 범례 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,14,0,0">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource Brand}"
                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="선택한 날" Style="{StaticResource Caption}" Margin="0,0,18,0"/>

                        <Border Width="9" Height="9" CornerRadius="2" Background="#EDF5EE"
                                BorderBrush="{StaticResource Brand}" BorderThickness="1"
                                VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="오늘" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ 오른쪽: 그날의 정보 ══ -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,24,24,0">
                        <StackPanel>

                            <!-- 공휴일 / 절기 -->
                            <Border Style="{StaticResource InfoCard}"
                                    Background="#FFF8F1" BorderBrush="#F6D5B8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="🎌" FontSize="15" Margin="0,0,8,0"/>
                                        <TextBlock Text="공휴일 · 절기" FontSize="12.5" FontWeight="Bold"
                                                   Foreground="#9C5221" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="txtHolidayEvent"
                                               Text="등록된 특별한 이벤트가 없습니다."
                                               FontSize="14.5" Foreground="{StaticResource Ink}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 오늘의 식단 -->
                            <Border Style="{StaticResource InfoCard}"
                                    Background="{StaticResource BrandTint}" BorderBrush="#CFE3D1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="🍱" FontSize="15" Margin="0,0,8,0"/>
                                        <TextBlock Text="이 날의 식단" FontSize="12.5" FontWeight="Bold"
                                                   Foreground="#2F5233" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="txtTodayMenu"
                                               Text="식단 자동 조합에서 만든 식단이 여기에 표시됩니다."
                                               FontSize="14.5" Foreground="{StaticResource Ink}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 일정 목록 -->
                            <StackPanel Orientation="Horizontal" Margin="2,12,0,10">
                                <TextBlock Text="급식소 일정" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource Ink}"/>
                                <Border Background="{StaticResource CanvasSoft}" CornerRadius="9"
                                        Padding="8,2" Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtEventCount" Text="0"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource InkSubtle}"/>
                                </Border>
                            </StackPanel>

                            <Border Background="{StaticResource CanvasSoft}" CornerRadius="10"
                                    Padding="6" Margin="0,0,0,8">
                                <Grid>
                                    <ListBox x:Name="lstEvents"
                                             SelectionChanged="lstEvents_SelectionChanged"
                                             MinHeight="118" MaxHeight="190"
                                             Background="Transparent" BorderThickness="0"
                                             FontSize="14"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="10,9"/>
                                                <Setter Property="Margin" Value="0,0,0,3"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Bd" CornerRadius="8"
                                                                    Background="White"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Margin="{TemplateBinding Margin}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background"
                                                                            Value="{StaticResource BrandTint}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background"
                                                                            Value="#F0F6F1"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>

                                    <!-- 일정이 없을 때 -->
                                    <TextBlock x:Name="txtNoEvents"
                                               Text="등록된 일정이 없습니다"
                                               FontSize="13" Foreground="{StaticResource InkFaint}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- 입력 + 버튼 -->
                    <Border Grid.Row="1" Background="{StaticResource CanvasSoft}"
                            CornerRadius="0,0,12,12" Padding="24,18">
                        <StackPanel>
                            <TextBlock Text="일정 내용" Style="{StaticResource Caption}" Margin="2,0,0,7"/>

                            <TextBox x:Name="txtEventInput" Height="72"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalContentAlignment="Top" Padding="10,8"
                                     VerticalScrollBarVisibility="Auto"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" x:Name="btnAddEvent" Click="btnAddEvent_Click"
                                        Content="＋  일정 등록" Style="{StaticResource PrimaryButton}"/>

                                <Button Grid.Column="2" x:Name="btnEditEvent" Click="btnEditEvent_Click"
                                        Content="수정" Width="76" Height="42"
                                        ToolTip="목록에서 일정을 고른 뒤 내용을 바꾸고 누르세요"/>

                                <Button Grid.Column="4" x:Name="btnDeleteEvent" Click="btnDeleteEvent_Click"
                                        Content="삭제" Width="76" Height="42"
                                        Style="{StaticResource DangerButton}"
                                        ToolTip="목록에서 고른 일정을 지웁니다"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
