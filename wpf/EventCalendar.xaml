<Page x:Class="wpf.EventCalendar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:wpf"
      mc:Ignorable="d" 
      Title="EventCalendar" Height="650" Width="950"
      Background="#F5F6FA">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="이벤트 및 절기 달력" FontSize="24" FontWeight="Bold" Foreground="#1A202C"/>
                <TextBlock Text="학교/기업의 주요 이벤트, 학사 일정 및 전통 절기별 맞춤 식단 제안 요소를 관리합니다." FontSize="12" Foreground="#A0AEC0" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" Padding="20" Margin="0,0,15,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📅 스케줄러" FontSize="16" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,0,15"/>
                    <Calendar Grid.Row="1" x:Name="MainCalendar" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="10" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🔍 일별 세부 정보" FontSize="16" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,0,10"/>
                    <Separator Grid.Row="1" Background="#E2E8F0" Margin="0,0,0,15"/>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="선택된 날짜:" FontSize="13" Foreground="#718096" Margin="0,0,0,4"/>
                        <TextBlock x:Name="txtSelectedDate" Text="날짜를 선택해주세요" FontSize="18" FontWeight="Bold" Foreground="#3182CE" Margin="0,0,0,15"/>

                        <TextBlock Text="📌 등록된 이벤트 리스트" FontSize="13" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,8"/>
                        <ListBox x:Name="lstEvents" MinHeight="100" MaxHeight="150" Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,15" Padding="5" SelectionChanged="lstEvents_SelectionChanged"/>

                        <TextBlock Text="✏️ 일정 내용 입력" FontSize="13" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtEventInput" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Padding="8" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"/>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="btnAddEvent" Content="➕ 등록" Click="btnAddEvent_Click" Height="40" Background="#3182CE" BorderThickness="0" Foreground="White" FontWeight="Bold" Margin="0,0,4,0" Padding="0" FontSize="13">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Grid.Column="1" x:Name="btnEditEvent" Content="🔄 수정" Click="btnEditEvent_Click" Height="40" Background="#48BB78" BorderThickness="0" Foreground="White" FontWeight="Bold" Margin="2,0,2,0" Padding="0" FontSize="13">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Grid.Column="2" x:Name="btnDeleteEvent" Content="🗑️ 삭제" Click="btnDeleteEvent_Click" Height="40" Background="#E53E3E" BorderThickness="0" Foreground="White" FontWeight="Bold" Margin="4,0,0,0" Padding="0" FontSize="13">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
