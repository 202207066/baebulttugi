<Page x:Class="wpf.EventCalendar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:wpf"
      mc:Ignorable="d"
      Title="EventCalendar"
      Background="{StaticResource Canvas}"
      FontFamily="{StaticResource UiFont}">

    <Page.Resources>
      <ResourceDictionary>
       <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CleanCalendar.xaml"/></ResourceDictionary.MergedDictionaries>
       <Style x:Key="InfoCard" TargetType="Border"><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,14"/><Setter Property="BorderThickness" Value="1"/></Style>
      </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="24" MinHeight="720">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 머리말 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="식단과 일정" Style="{StaticResource PageTitle}"/>
            <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource InkSubtle}"
                       TextWrapping="Wrap" Text="빨강: 일요일·공휴일 / 파랑: 토요일 / 파란 점: 내 일정 / 주황 표시: 특식 행사 (2026년 기본 자료)"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ══ 왼쪽: 달력 ══ -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,2,24">
                     <StackPanel>
                      <TextBlock x:Name="txtBannerYear" Text="선택한 날짜" FontSize="12" Foreground="#7C8E83"/>
                      <TextBlock x:Name="txtSelectedDate" Text="날짜를 선택해 주세요" FontSize="22" FontWeight="SemiBold" Foreground="#243C2E" Margin="0,6,0,0"/>
                     </StackPanel>
                     <Border x:Name="BadgeHoliday" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" Background="#FFF3E4" CornerRadius="12" Padding="12,7">
                      <TextBlock x:Name="txtBadgeHoliday" Foreground="#A46831" FontSize="12" FontWeight="SemiBold"/>
                     </Border>
                    </Grid>
                    <Calendar Grid.Row="1" x:Name="MainCalendar" Style="{StaticResource CleanCalendar}" FirstDayOfWeek="Sunday" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>

                    <!-- 범례 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,14,0,0">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource Brand}"
                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="선택한 날" Style="{StaticResource Caption}" Margin="0,0,18,0"/>

                        <Border Width="9" Height="9" CornerRadius="2" Background="#EDF5EE"
                                BorderBrush="{StaticResource Brand}" BorderThickness="1"
                                VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="오늘" Style="{StaticResource Caption}"/><TextBlock Text="  ● 내 일정  ▪ 특식 행사" Foreground="#3176B5" FontSize="12" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ 오른쪽: 그날의 정보 ══ -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,24,24,0">
                        <StackPanel>

                            <!-- 공휴일 / 절기 -->
                            <Border Style="{StaticResource InfoCard}"
                                    Background="#FFF8F1" BorderBrush="#F6D5B8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="🎌" FontSize="15" Margin="0,0,8,0"/>
                                        <TextBlock Text="공휴일 · 절기" FontSize="12.5" FontWeight="Bold"
                                                   Foreground="#9C5221" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="txtHolidayEvent"
                                               Text="등록된 특별한 이벤트가 없습니다."
                                               FontSize="14.5" Foreground="{StaticResource Ink}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 오늘의 식단 -->
                            <Border Style="{StaticResource InfoCard}"
                                    Background="{StaticResource BrandTint}" BorderBrush="#CFE3D1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="🍱" FontSize="15" Margin="0,0,8,0"/>
                                        <TextBlock Text="이 날의 식단" FontSize="12.5" FontWeight="Bold"
                                                   Foreground="#2F5233" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ListBox x:Name="lstTodayMeals" BorderThickness="0" Background="Transparent" FontSize="14.5" IsHitTestVisible="False">
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Background" Value="White"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                    </ListBox>
                                    <Button x:Name="BtnCreateMeal" Content="식단 만들기" Click="CreateMeal_Click" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" HorizontalAlignment="Left" Padding="14,8"/>
                                </StackPanel>
                            </Border>

                            <!-- 일정 목록 -->
                            <StackPanel Orientation="Horizontal" Margin="2,12,0,10">
                                <TextBlock Text="급식소 일정" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource Ink}"/>
                                <Border Background="{StaticResource CanvasSoft}" CornerRadius="9"
                                        Padding="8,2" Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtEventCount" Text="0"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource InkSubtle}"/>
                                </Border>
                            </StackPanel>

                            <Border Background="{StaticResource CanvasSoft}" CornerRadius="10"
                                    Padding="6" Margin="0,0,0,8">
                                <Grid>
                                    <ListBox x:Name="lstEvents"
                                             SelectionChanged="lstEvents_SelectionChanged"
                                             MinHeight="118" MaxHeight="190"
                                             Background="Transparent" BorderThickness="0"
                                             FontSize="14"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="10,9"/>
                                                <Setter Property="Margin" Value="0,0,0,3"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Bd" CornerRadius="8"
                                                                    Background="White"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Margin="{TemplateBinding Margin}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background"
                                                                            Value="{StaticResource BrandTint}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background"
                                                                            Value="#F0F6F1"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>

                                    <!-- 일정이 없을 때 -->
                                    <TextBlock x:Name="txtNoEvents"
                                               Text="등록된 일정이 없습니다"
                                               FontSize="13" Foreground="{StaticResource InkFaint}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- 입력 + 버튼 -->
                    <Border Grid.Row="1" Background="{StaticResource CanvasSoft}"
                            CornerRadius="0,0,12,12" Padding="24,18">
                        <StackPanel>
                            <TextBlock Text="일정 내용" Style="{StaticResource Caption}" Margin="2,0,0,7"/>

                            <TextBox x:Name="txtEventInput" Height="72"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalContentAlignment="Top" Padding="10,8"
                                     VerticalScrollBarVisibility="Auto"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" x:Name="btnAddEvent" Click="btnAddEvent_Click"
                                        Content="＋  일정 등록" Style="{StaticResource PrimaryButton}"/>

                                <Button Grid.Column="2" x:Name="btnEditEvent" Click="btnEditEvent_Click"
                                        Content="수정" Width="76" Height="42"
                                        ToolTip="목록에서 일정을 고른 뒤 내용을 바꾸고 누르세요"/>

                                <Button Grid.Column="4" x:Name="btnDeleteEvent" Click="btnDeleteEvent_Click"
                                        Content="삭제" Width="76" Height="42"
                                        Style="{StaticResource DangerButton}"
                                        ToolTip="목록에서 고른 일정을 지웁니다"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid></ScrollViewer>
</Page>
