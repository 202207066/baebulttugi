<Page x:Class="wpf.Menu_table"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:wpf"
      mc:Ignorable="d" 
      d:DesignHeight="688" d:DesignWidth="1116"
      Title="식단 자동 조합 설정">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,25">
            <StackPanel>
                <TextBlock Text="식단 자동 조합 설정" FontSize="26" FontWeight="Bold" Foreground="#1A202C"/>
                <TextBlock Text="피급식자의 건강을 위한 영양소별 적정량 규칙을 설정하고 식단을 조합합니다." FontSize="13" Foreground="#718096" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,20,0">
                <Button Background="#EBF8FF" Foreground="#2B6CB0" BorderThickness="0" Height="48" Margin="0,0,0,10" Padding="15,0" HorizontalContentAlignment="Left">
                    <TextBlock Text="⚙️ 식단 적정량 조합" FontSize="14" FontWeight="SemiBold"/>
                </Button>
                <Button Background="Transparent" Foreground="#4A5568" BorderThickness="0" Height="48" Margin="0,0,0,10" Padding="15,0" HorizontalContentAlignment="Left">
                    <TextBlock Text="✏️ 기본 메뉴 직접 입력" FontSize="14"/>
                </Button>
            </StackPanel>

            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="10" Padding="30" BorderBrush="#E2E8F0" BorderThickness="1" VerticalAlignment="Top">
                <StackPanel>

                    <TextBlock Text="📊 영양소별 적정 기준량 설정" FontSize="18" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,0,25"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>

                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#4A5568"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Height" Value="40"/>
                                <Setter Property="Background" Value="#F7FAFC"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Margin" Value="0,6"/>
                            </Style>
                        </Grid.Resources>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="탄수화물 적정량"/>
                        <TextBox x:Name="TxtCarb" Grid.Row="0" Grid.Column="1" Tag="탄수화물 적정량 입력"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="g" Foreground="#A0AEC0" Margin="10,0,0,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="단백질 적정량"/>
                        <TextBox x:Name="TxtProtein" Grid.Row="1" Grid.Column="1" Tag="단백질 적정량 입력"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="g" Foreground="#A0AEC0" Margin="10,0,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="지방 적정량"/>
                        <TextBox x:Name="TxtFat" Grid.Row="2" Grid.Column="1" Tag="지방 적정량 입력"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="g" Foreground="#A0AEC0" Margin="10,0,0,0"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="총 칼로리 권장량" Foreground="#4A90E2"/>
                        <TextBox x:Name="TxtCalories" Grid.Row="3" Grid.Column="1" Tag="칼로리 적정량 입력" BorderBrush="#90CDF4" Background="#F0F8FF"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="kcal" Foreground="#A0AEC0" Margin="10,0,0,0"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                        <Button Content="초기화" Click="BtnReset_Click" Width="100" Height="40" Background="#EDF2F7" Foreground="#4A5568" BorderThickness="0" Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="🤖 식단 자동 조합 실행" Click="BtnExecute_Click" Width="180" Height="40" Background="#4A90E2" Foreground="White" BorderThickness="0" FontWeight="Bold">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>