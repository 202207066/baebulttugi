<Page x:Class="wpf.Menu_table" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="식단 만들기" Background="#F4F7F3" Foreground="#263E2F" FontSize="14" FontFamily="{StaticResource UiFont}">
 <Page.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PlannerStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Page.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="30,26"  HorizontalAlignment="Stretch">
   <Grid Margin="0,0,0,24"><StackPanel><TextBlock Text="우리 급식소의 한 주 식단" FontSize="26" FontWeight="Bold"/><TextBlock Text="제공일과 한 끼 영양 목표를 정해 주세요. 설정에 맞는 식단을 만들어 내 시트에 저장합니다." Foreground="#718276" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Grid>
   <StackPanel x:Name="SettingsPanel">
    <Border Style="{StaticResource PlannerCard}"><StackPanel>
     <TextBlock Text="01   언제, 누구에게 제공하나요?" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,20"/>
     <WrapPanel Margin="0,0,0,22">
      <StackPanel Width="280" Margin="0,0,24,8"><TextBlock Text="메뉴 출처" Foreground="#718276" Margin="0,0,0,8"/><ComboBox x:Name="CboAgeGroup" SelectionChanged="AgeChanged"><ComboBoxItem Content="만 3~5세 · 트랙A" Tag="3-5"/><ComboBoxItem Content="만 6~18세 · 트랙B" Tag="6-18"/></ComboBox></StackPanel>
      <StackPanel Width="150" Margin="0,0,18,8"><TextBlock Text="대상 연령" Foreground="#718276" Margin="0,0,0,8"/><ComboBox x:Name="CboNutritionAge" SelectionChanged="NutritionProfileChanged"><ComboBoxItem Content="만 3~5세" Tag="3-5"/><ComboBoxItem Content="만 6~8세" Tag="6-8"/><ComboBoxItem Content="만 9~11세" Tag="9-11"/><ComboBoxItem Content="만 12~14세" Tag="12-14"/><ComboBoxItem Content="만 15~18세" Tag="15-18"/></ComboBox></StackPanel>
      <StackPanel Width="110" Margin="0,0,18,8"><TextBlock Text="성별" Foreground="#718276" Margin="0,0,0,8"/><ComboBox x:Name="CboSex" SelectionChanged="NutritionProfileChanged"><ComboBoxItem Content="공통" Tag="공통"/><ComboBoxItem Content="남" Tag="남"/><ComboBoxItem Content="여" Tag="여"/></ComboBox></StackPanel>
      <StackPanel Width="260" Margin="0,0,0,8"><TextBlock Text="날짜 선택 · 해당 주의 일~토" Foreground="#718276" Margin="0,0,0,8"/><DatePicker x:Name="WeekPicker" FirstDayOfWeek="Sunday" SelectedDateChanged="WeekChanged"/></StackPanel>
     </WrapPanel>
     <WrapPanel>
      <StackPanel Margin="0,0,32,0"><TextBlock Text="제공 요일" Margin="0,0,0,10" FontWeight="SemiBold"/><WrapPanel x:Name="DayPanel"><CheckBox Style="{StaticResource ChoiceChip}" Content="월" Tag="1" IsChecked="True"/><CheckBox Style="{StaticResource ChoiceChip}" Content="화" Tag="2" IsChecked="True"/><CheckBox Style="{StaticResource ChoiceChip}" Content="수" Tag="3" IsChecked="True"/><CheckBox Style="{StaticResource ChoiceChip}" Content="목" Tag="4" IsChecked="True"/><CheckBox Style="{StaticResource ChoiceChip}" Content="금" Tag="5" IsChecked="True"/><CheckBox Style="{StaticResource ChoiceChip}" Content="토" Tag="6" IsChecked="False"/><CheckBox Style="{StaticResource ChoiceChip}" Content="일" Tag="0" IsChecked="False"/></WrapPanel></StackPanel>
      <StackPanel><TextBlock Text="제공 끼니" Margin="0,0,0,10" FontWeight="SemiBold"/><WrapPanel x:Name="MealPanel"><CheckBox Style="{StaticResource ChoiceChip}" Content="아침" Tag="조식" Checked="MealCountChanged" Unchecked="MealCountChanged"/><CheckBox Style="{StaticResource ChoiceChip}" Content="점심" Tag="중식" IsChecked="True" Checked="MealCountChanged" Unchecked="MealCountChanged"/><CheckBox Style="{StaticResource ChoiceChip}" Content="저녁" Tag="석식" Checked="MealCountChanged" Unchecked="MealCountChanged"/></WrapPanel></StackPanel>
     </WrapPanel>
     <TextBlock x:Name="ScheduleStatus" TextWrapping="Wrap" Foreground="#94532D" Margin="0,14,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource PlannerCard}"><StackPanel>
     <TextBlock Text="02   한 끼 영양 목표를 정해 주세요" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock x:Name="NutritionProfileStatus" Text="성별·연령과 제공 끼니를 선택하면 2025 기준으로 자동 설정합니다." Foreground="#718276" Margin="0,7,0,20" TextWrapping="Wrap"/>
     <WrapPanel>
      <StackPanel Width="190" Margin="0,0,18,8"><TextBlock Text="탄수화물 · g" Foreground="#718276" Margin="0,0,0,8"/><TextBox x:Name="TxtCarb" AutomationProperties.Name="한 끼 탄수화물 목표(g)"/></StackPanel>
      <StackPanel Width="190" Margin="0,0,18,8"><TextBlock Text="단백질 · g" Foreground="#718276" Margin="0,0,0,8"/><TextBox x:Name="TxtProtein" AutomationProperties.Name="한 끼 단백질 목표(g)"/></StackPanel>
      <StackPanel Width="190" Margin="0,0,18,8"><TextBlock Text="지방 · g" Foreground="#718276" Margin="0,0,0,8"/><TextBox x:Name="TxtFat" AutomationProperties.Name="한 끼 지방 목표(g)"/></StackPanel>
      <StackPanel Width="170" Margin="0,0,0,8"><TextBlock Text="목표 허용 편차 · %" Foreground="#718276" Margin="0,0,0,8"/><TextBox x:Name="TxtTolerance" Text="15"/></StackPanel>
      <StackPanel Width="170" Margin="0,0,0,8"><TextBlock Text="한 끼 목표 원가 · 원" Foreground="#718276" Margin="0,0,0,8"/><TextBox x:Name="TxtTargetCost" Text="5000" TextChanged="TargetCostChanged"/></StackPanel>
     </WrapPanel>
     <Border Background="#F1F6EF" CornerRadius="10" Padding="14,12" Margin="0,14,0,0"><StackPanel>
      <CheckBox x:Name="ExcludeAllergens" Content="등록된 알레르기 성분의 메뉴 제외" IsChecked="True" Foreground="#315D40" FontWeight="SemiBold"/>
      <TextBlock Text="제공 전에는 메뉴의 실제 레시피와 알레르기 표시를 확인해 주세요." Foreground="#718276" FontSize="12" Margin="22,6,0,0" TextWrapping="Wrap"/>
     </StackPanel></Border>
     <Expander x:Name="NutritionGuide" Style="{StaticResource GuideExpander}" Header="영양 목표와 계산 기준 안내" HorizontalContentAlignment="Stretch" Foreground="#45654F" FontSize="13" Margin="0,16,0,0">
      <Border Background="#F3F7F2" CornerRadius="12" Padding="18" Margin="0,10,0,0">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Grid.Column="0" Text="한 끼 기준" FontWeight="SemiBold" Margin="0,8,16,8"/><TextBlock Grid.Row="0" Grid.Column="1" Text="하루 에너지 기준을 세 끼로 나눠 한 끼 목표를 설정합니다. 제공할 끼니를 선택해도 한 끼 기준은 유지됩니다." TextWrapping="Wrap" LineHeight="22" Margin="0,5,0,8"/><TextBlock Grid.Row="1" Grid.Column="0" Text="열량 계산" FontWeight="SemiBold" Margin="0,8,16,8"/><TextBlock Grid.Row="1" Grid.Column="1" Text="메뉴에 열량이 없으면 탄수화물 × 4 + 단백질 × 4 + 지방 × 9로 계산합니다. 영양량이 부족하면 열량 미확인으로 표시합니다." TextWrapping="Wrap" LineHeight="22" Margin="0,5,0,8"/><TextBlock Grid.Row="2" Grid.Column="0" Text="허용 편차" FontWeight="SemiBold" Margin="0,8,16,8"/><TextBlock Grid.Row="2" Grid.Column="1" Text="입력한 목표와 식단의 차이를 비교하는 범위입니다. 15%는 초기 설정값이며, 급식 운영 기준에 맞게 조정할 수 있습니다." TextWrapping="Wrap" LineHeight="22" Margin="0,5,0,8"/><TextBlock Grid.Row="3" Grid.Column="0" Text="영양량 단위" FontWeight="SemiBold" Margin="0,8,16,8"/><TextBlock Grid.Row="3" Grid.Column="1" Text="메뉴별 해당 연령의 1인분 영양량을 합산합니다. 배식 인원에 따른 총 소요량은 원가·소요량 계산에서 확인하세요." TextWrapping="Wrap" LineHeight="22" Margin="0,5,0,8"/></Grid></Border></Expander>
    </StackPanel></Border>
    <Border Style="{StaticResource PlannerCard}" Padding="24,18"><Expander Header="03   꼭 포함할 메뉴가 있나요? (선택 사항)" FontSize="15" Foreground="#315D40"><StackPanel><TextBlock Text="영양정보가 있는 메뉴만 표시됩니다. 선택하면 한 끼 목표 대비 영양 오차를 바로 확인할 수 있습니다." Foreground="#718276" FontSize="12" Margin="0,14,0,4" TextWrapping="Wrap"/><WrapPanel x:Name="FixedPanel"/><Border Background="#F1F6EF" CornerRadius="10" Padding="12" Margin="0,16,0,0"><TextBlock x:Name="FixedMenuStatus" Text="메뉴를 선택하면 열량·탄수화물·단백질·지방 오차를 표시합니다. 원가는 원가 화면에 저장한 구매 단가 기준으로 계산합니다." TextWrapping="Wrap" Foreground="#526D57"/></Border></StackPanel></Expander></Border>
    <WrapPanel Margin="0,2,0,18"><Button Content="한 주 식단 만들고 저장" Click="Execute_Click" Style="{StaticResource PrimaryButton}" Height="48" Padding="24,0" Margin="0,0,12,8"/><Button Content="메뉴 새로고침" Click="Refresh_Click" Height="48" Margin="0,0,8,8"/><Button Content="설정 초기화" Click="Reset_Click" Style="{StaticResource GhostButton}" Height="48" Margin="0,0,0,8"/></WrapPanel>
   </StackPanel>
   <Border Background="#EAF1E7" CornerRadius="12" Padding="18,14" Margin="0,0,0,16"><TextBlock x:Name="DataStatus" Text="메뉴 자료를 확인하고 있습니다." TextWrapping="Wrap" Foreground="#526D57" FontSize="13"/></Border>
   <TextBlock x:Name="SaveStatus" TextWrapping="Wrap" Margin="0,0,0,12" FontWeight="SemiBold"/>
   <Button x:Name="RetrySave" Content="같은 결과 저장 재시도" Click="RetrySave_Click" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,0,0,16"/>
   <Border Style="{StaticResource PlannerCard}"><StackPanel>
    <TextBlock x:Name="WeekTitle" Text="이번 주 식단" FontSize="23" FontWeight="SemiBold"/>
    <TextBlock Text="수정하기를 누른 뒤 메뉴 칸 또는 요일 제목을 선택하세요. 황색 표시는 수정 중입니다." Foreground="#718276" Margin="0,6,0,16"/>
    <WrapPanel Margin="0,0,0,12"><Button Content="새로고침" Click="LoadWeek_Click" Margin="0,0,10,8"/><Button x:Name="EditModeButton" Content="수정하기" Click="EditMeal_Click" Margin="0,0,10,8"/><Button x:Name="DeleteMealButton" Content="삭제하기" Click="DeleteMeal_Click" Margin="0,0,10,8"/><Button Content="PDF 만들기" Click="ExportPdf_Click" Margin="0,0,10,8"/><Button x:Name="DeleteWeekButton" IsEnabled="False" Content="이번 주 전체 삭제" Click="DeleteWeekMeals_Click" Style="{StaticResource DangerButton}" Margin="0,0,10,8"/></WrapPanel>
    <Grid><DataGrid x:Name="GridDietResult" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="220" MaxHeight="700" HorizontalScrollBarVisibility="Disabled" HeadersVisibility="Column" RowHeight="NaN" MinRowHeight="52" EnableRowVirtualization="True">
    <DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGrid.Resources><DataGrid.Columns>
     <DataGridTextColumn Header="날짜" Binding="{Binding DateText, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="요일" Binding="{Binding Day, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="끼니" Binding="{Binding Meal, Mode=OneWay}" Width="*"/>
     <DataGridTextColumn Header="밥류" Binding="{Binding Rice, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="국류" Binding="{Binding Soup, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="주찬" Binding="{Binding Main, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="부찬" Binding="{Binding Side, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="김치류" Binding="{Binding Kimchi, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="후식류" Binding="{Binding Dessert, Mode=OneWay}" Width="*"/>
    </DataGrid.Columns>
    </DataGrid><TextBlock Text="선택한 주·연령에 저장된 식단이 없습니다." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8A9B8D" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count,ElementName=GridDietResult}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    <TextBlock x:Name="SelectedMealSummary" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#56745F" Text="수정하기를 누르면 메뉴와 요일별 식단을 수정할 수 있습니다."/>
   </StackPanel></Border>
  </StackPanel>
 </ScrollViewer>
</Page>
