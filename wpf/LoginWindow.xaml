<Window x:Class="wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="구글 계정 연결" Height="340" Width="480" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="True">
    <Grid Background="White">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="내 구글 드라이브에 식단을 저장합니다." FontSize="16" Margin="0,0,0,16"/>
            <TextBlock x:Name="LoginStatus" Text="아래 버튼을 누르고 브라우저에서 계정을 선택해 주세요." Width="400" TextWrapping="Wrap" Margin="0,0,0,14"/>
            <ProgressBar x:Name="LoginProgress" IsIndeterminate="True" Height="5" Width="400" Margin="0,0,0,20" Visibility="Collapsed"/>
            <Button x:Name="LoginButton" Content="구글 계정으로 로그인" Width="220" Height="40" Click="OkButton_Click" Background="#2E7D32" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>
            <Button x:Name="CancelLogin" Content="취소 및 종료" Width="220" Height="34" Click="CancelButton_Click" Background="#E2E8F0"/>
        </StackPanel>
    </Grid>
</Window>
