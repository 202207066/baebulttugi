<Window x:Class="wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="구글 로그인 인증" Height="250" Width="400" WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="스마트 식단 배포를 위해 구글 로그인이 필요합니다." FontSize="14" Margin="0,0,0,20"/>
            <Button Content="구글 계정으로 로그인" Width="200" Height="40" Click="OkButton_Click" Background="#4A90E2" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>
            <Button Content="취소 및 종료" Width="200" Height="30" Click="CancelButton_Click" Background="#E2E8F0"/>
        </StackPanel>
    </Grid>
</Window>