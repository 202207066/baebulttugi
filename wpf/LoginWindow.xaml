<Window x:Class="wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="배불뚝이 · Google 계정 연결" Height="620" Width="540"
        MinHeight="500" MinWidth="500" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" ShowInTaskbar="True">
    <ScrollViewer Background="#F5F8F5" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">
            <TextBlock Text="배불뚝이" Foreground="#2E7D32" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>
            <TextBlock x:Name="LoginHeading" Text="Google 계정 연결" FontSize="25" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock Text="내 Google Drive에 식단을 저장합니다." FontSize="15" Margin="0,0,0,20"/>
            <Border Background="White" BorderBrush="#DCE5DC" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="LoginStatus" Text="아래 버튼을 누르고 브라우저에서 계정을 선택해 주세요." TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
                    <TextBlock x:Name="LoginDetails" Foreground="#64748B" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            <ProgressBar x:Name="LoginProgress" IsIndeterminate="True" Height="5" Margin="0,0,0,16" Visibility="Collapsed"/>
            <Button x:Name="LoginButton" Content="Google 계정으로 로그인" Height="42" Click="OkButton_Click" Background="#2E7D32" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>
            <Button x:Name="SwitchAccountButton" Content="다른 Google 계정으로 로그인" Height="42" Click="SwitchAccount_Click" Background="White" Foreground="#245B29" BorderBrush="#AFC7B0" Margin="0,0,0,10"/>
            <TextBlock Text="계정을 바꿔도 기존 계정의 식단은 삭제되지 않습니다.&#x0a;새로 선택한 계정의 자료로 연결됩니다." Foreground="#526052" TextWrapping="Wrap" FontSize="12" LineHeight="18" Margin="0,0,0,14"/>
            <Button x:Name="CancelLogin" Content="앱 종료" Height="34" Click="CancelButton_Click" Background="#E2E8F0"/>
            <Button Content="개인정보 처리 안내" Click="Privacy_Click" Margin="0,10,0,0" Padding="10,6" Background="Transparent" BorderThickness="0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
