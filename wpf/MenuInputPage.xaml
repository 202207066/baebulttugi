<Page x:Class="wpf.MenuInputPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:wpf" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F8F4" Foreground="#263E2F" FontSize="14" FontFamily="{StaticResource UiFont}">
<Page.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PlannerStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Page.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="28" x:Name="Root"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="메뉴·레시피 관리" FontSize="28" FontWeight="Bold"/><TextBlock Text="공통 메뉴를 선택해 내 레시피로 수정하거나 새 메뉴를 등록하세요. 저장한 내용은 내 식단 조합에 적용됩니다." TextWrapping="Wrap" Margin="0,8,0,16"/>
<ComboBox x:Name="Track" Width="300" HorizontalAlignment="Left" SelectionChanged="TrackChanged"><ComboBoxItem Content="트랙 A · 만 3~5세" Tag="3-5"/><ComboBoxItem Content="트랙 B · 만 6~18세" Tag="6-18"/></ComboBox><TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,10,0,14"/></StackPanel>
<Border Grid.Row="1" Style="{StaticResource PlannerCard}"><StackPanel>
<WrapPanel><StackPanel Width="240" Margin="0,0,14,10"><TextBlock Text="메뉴명"/><TextBox x:Name="NameBox"/></StackPanel><StackPanel Width="160" Margin="0,0,14,10"><TextBlock Text="분류"/><ComboBox x:Name="CategoryBox"/></StackPanel></WrapPanel><TextBlock Text="알레르기 유발 성분 · 해당 항목을 모두 선택하세요"/><local:AllergenPicker x:Name="AllergyBox" MaxWidth="650" HorizontalAlignment="Left" Margin="0,4,0,16"/>
<TextBlock Text="선택한 연령의 1인분 기준 · 빈 영양값은 미등록으로 보관됩니다." Margin="0,0,0,8"/>
<WrapPanel><StackPanel Width="135" Margin="0,0,12,12"><TextBlock Text="탄수화물 (g)"/><TextBox x:Name="CarbBox"/></StackPanel><StackPanel Width="135" Margin="0,0,12,12"><TextBlock Text="단백질 (g)"/><TextBox x:Name="ProteinBox"/></StackPanel><StackPanel Width="135" Margin="0,0,12,12"><TextBlock Text="지방 (g)"/><TextBox x:Name="FatBox"/></StackPanel><StackPanel Width="190" Margin="0,0,12,12"><TextBlock Text="열량 (kcal, 비우면 계산)"/><TextBox x:Name="EnergyBox"/></StackPanel></WrapPanel>
<WrapPanel Margin="0,0,0,12"><StackPanel Width="200" Margin="0,0,14,0"><TextBlock Text="완성 음식 1인분 제공량(g)"/><TextBox x:Name="ServingBox" ToolTip="모르면 비워 두세요. g·kg 재료 합계가 있으면 대용하며 근거를 표시합니다."/></StackPanel><StackPanel><CheckBox x:Name="ProteinReviewedBox" Content="제공량·단백질 기준 검토 완료 (자동 생성에 사용)" Margin="0,4"/><CheckBox x:Name="IngredientsConfirmedBox" Content="제품 원재료를 포함한 알레르기 목록 확인 완료" Margin="0,4"/></StackPanel></WrapPanel><TextBlock x:Name="ReviewSummary" TextWrapping="Wrap" Foreground="#9C481C" Margin="0,0,0,12"/>
<TextBlock Text="식재료·1인분 정미량 (원가 계산과 함께 사용)" FontWeight="Bold"/><TextBlock Text="식재료명·분량·단위를 행별로 입력하세요. 양념도 포함합니다. 빈 구매가격은 미입력으로 보관합니다." TextWrapping="Wrap" Margin="0,6,0,8"/>
<DataGrid x:Name="RecipeIngredients" AutoGenerateColumns="False" MinHeight="180" MaxHeight="320" CanUserAddRows="True" CanUserDeleteRows="True" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="식재료명" Binding="{Binding Name}" Width="220"/><DataGridTextColumn Header="1인분 정미량" Binding="{Binding Amount}" Width="110"/><DataGridTextColumn Header="단위" Binding="{Binding Unit}" Width="65"/><DataGridTextColumn Header="폐기율(%)" Binding="{Binding WastePercent}" Width="100"/><DataGridTextColumn Header="구매가격(원)" Binding="{Binding Price}" Width="115"/><DataGridTextColumn Header="가격 기준량" Binding="{Binding PriceQuantity}" Width="95"/><DataGridTextColumn Header="가격 단위" Binding="{Binding PriceUnit}" Width="90"/><DataGridTextColumn Header="개·봉당 중량(g)" Binding="{Binding PackageWeightGrams}" Width="135"/></DataGrid.Columns></DataGrid>
<TextBlock Text="조리법·메모 (위 식재료 표와 별도로 보관)" Margin="0,12,0,4"/><TextBox x:Name="IngredientsBox" Height="110" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap"><TextBox.Template><ControlTemplate TargetType="TextBox"><Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" Margin="10" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/></Border></ControlTemplate></TextBox.Template></TextBox><TextBlock Text="영양정보 출처·계산 근거" Margin="0,8,0,0"/><TextBox x:Name="SourceBox"/>
<WrapPanel Margin="0,12,0,0"><Button Style="{StaticResource PrimaryButton}" Content="내 레시피 저장" Click="SaveClick" Padding="20,10" Margin="0,0,12,0"/><Button Content="새 메뉴 입력" Click="NewClick" Padding="20,10" Margin="0,0,12,0"/><Button Content="재료 공통 기준표 · 엑셀" Click="OpenStandards_Click" Padding="20,10" Margin="0,0,12,0"/><Button Content="메뉴 새로고침" Click="RefreshClick" Padding="20,10"/></WrapPanel>
</StackPanel></Border>
<Grid Grid.Row="2" MinHeight="360"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="메뉴명 검색" Margin="0,0,0,6"/><TextBox x:Name="SearchBox" ToolTip="메뉴명 검색" TextChanged="SearchChanged" Margin="0,0,0,8"/></StackPanel>
<DataGrid x:Name="MenuGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" SelectionChanged="MenuSelected" MaxHeight="480" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling" EnableRowVirtualization="True" EnableColumnVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="메뉴" Binding="{Binding DisplayName}" Width="300"/><DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="100"/><DataGridTextColumn Header="단백질 등급" Binding="{Binding ProteinGrade}" Width="110"/><DataGridTextColumn Header="탄수(g)" Binding="{Binding Carb}" Width="85"/><DataGridTextColumn Header="단백(g)" Binding="{Binding Protein}" Width="85"/><DataGridTextColumn Header="지방(g)" Binding="{Binding Fat}" Width="85"/><DataGridTextColumn Header="열량(kcal)" Binding="{Binding Calories}" Width="100"/></DataGrid.Columns></DataGrid></Grid>
</Grid></ScrollViewer></Page>