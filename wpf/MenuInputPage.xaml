<Page x:Class="wpf.MenuInputPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F8F4" Foreground="#263E2F" FontSize="14" FontFamily="{StaticResource UiFont}">
<Page.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PlannerStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Page.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="28" x:Name="Root"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="메뉴·레시피 관리" FontSize="28" FontWeight="Bold"/><TextBlock Text="공통 메뉴를 선택해 내 레시피로 수정하거나 새 메뉴를 등록하세요. 저장한 내용은 내 식단 조합에 적용됩니다." TextWrapping="Wrap" Margin="0,8,0,16"/>
<ComboBox x:Name="Track" Width="300" HorizontalAlignment="Left" SelectionChanged="TrackChanged"><ComboBoxItem Content="트랙 A · 만 3~5세" Tag="3-5"/><ComboBoxItem Content="트랙 B · 만 6~18세" Tag="6-18"/></ComboBox><TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,10,0,14"/></StackPanel>
<Border Grid.Row="1" Style="{StaticResource PlannerCard}"><StackPanel>
<WrapPanel><StackPanel Width="240" Margin="0,0,14,10"><TextBlock Text="메뉴명"/><TextBox x:Name="NameBox"/></StackPanel><StackPanel Width="160" Margin="0,0,14,10"><TextBlock Text="분류"/><ComboBox x:Name="CategoryBox"/></StackPanel><StackPanel Width="260" Margin="0,0,14,10"><TextBlock Text="알레르기 코드 (예: 1,5,6)"/><TextBox x:Name="AllergyBox"/></StackPanel></WrapPanel>
<TextBlock Text="선택한 연령의 1인분 기준 · 빈 영양값은 미등록으로 보관됩니다." Margin="0,0,0,8"/>
<WrapPanel><StackPanel Width="135" Margin="0,0,12,12"><TextBlock Text="탄수화물 (g)"/><TextBox x:Name="CarbBox"/></StackPanel><StackPanel Width="135" Margin="0,0,12,12"><TextBlock Text="단백질 (g)"/><TextBox x:Name="ProteinBox"/></StackPanel><StackPanel Width="135" Margin="0,0,12,12"><TextBlock Text="지방 (g)"/><TextBox x:Name="FatBox"/></StackPanel><StackPanel Width="190" Margin="0,0,12,12"><TextBlock Text="열량 (kcal, 비우면 계산)"/><TextBox x:Name="EnergyBox"/></StackPanel></WrapPanel>
<TextBlock Text="재료·1인분 분량·조리법"/><TextBox x:Name="IngredientsBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="영양정보 출처·계산 근거" Margin="0,8,0,0"/><TextBox x:Name="SourceBox"/>
<WrapPanel Margin="0,12,0,0"><Button Style="{StaticResource PrimaryButton}" Content="내 레시피 저장" Click="SaveClick" Padding="20,10" Margin="0,0,12,0"/><Button Content="새 메뉴 입력" Click="NewClick" Padding="20,10" Margin="0,0,12,0"/><Button Content="메뉴 새로고침" Click="RefreshClick" Padding="20,10"/></WrapPanel>
</StackPanel></Border>
<Grid Grid.Row="2" Height="360"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="메뉴명 검색" Margin="0,0,0,6"/><TextBox x:Name="SearchBox" ToolTip="메뉴명 검색" TextChanged="SearchChanged" Margin="0,0,0,8"/></StackPanel>
<DataGrid x:Name="MenuGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" SelectionChanged="MenuSelected" EnableRowVirtualization="True" EnableColumnVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="메뉴" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="분류" Binding="{Binding Category}"/><DataGridTextColumn Header="탄수(g)" Binding="{Binding Carb}"/><DataGridTextColumn Header="단백(g)" Binding="{Binding Protein}"/><DataGridTextColumn Header="지방(g)" Binding="{Binding Fat}"/><DataGridTextColumn Header="열량(kcal)" Binding="{Binding Calories}"/></DataGrid.Columns></DataGrid></Grid>
</Grid></ScrollViewer></Page>